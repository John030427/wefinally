# Server
PORT=3000
NODE_ENV=development

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=wefinally

# JWT
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# WeChat Mini Program
WX_APPID=your_wx_appid
WX_SECRET=your_wx_secret

# Local mini-program debugging only. Keep disabled by default.
DEV_WX_LOGIN_ENABLED=false
DEV_WX_OPENID=dev_wefinally_local_openid

# WeChat Pay
WXPAY_MCH_ID=your_mch_id
WXPAY_API_KEY=your_api_v2_key
WXPAY_NOTIFY_URL=https://your-domain.com/api/wxpay/notify

# Admin bootstrap (used when admins table is empty)
ADMIN_USER=admin
ADMIN_PASS=admin123456

# CORS
CORS_ORIGIN=*

# LLM / DeepSeek compatible endpoint
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_MATCH_REPORT_ENABLED=false
AI_MATCH_WEIGHT_ENABLED=false
AI_RERANK_TOP_K=5
