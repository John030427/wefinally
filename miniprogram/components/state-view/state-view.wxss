.state-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 48rpx;
  text-align: center;
}

.state-badge {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: var(--wf-primary-soft-2);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 28rpx;
}

.state-badge-icon {
  color: var(--wf-primary);
  opacity: 0.85;
}

.state-title {
  font-size: var(--wf-fs-h2);
  font-weight: 600;
  color: var(--wf-text-main);
  margin-bottom: 12rpx;
}

.state-desc {
  font-size: var(--wf-fs-caption);
  color: var(--wf-text-sub);
  margin-bottom: 32rpx;
  line-height: 1.7;
  max-width: 520rpx;
}

.state-btn {
  margin-top: 8rpx;
  font-size: var(--wf-fs-body);
  font-weight: 500;
  color: var(--wf-primary);
  padding: 18rpx 56rpx;
  border: 2rpx solid var(--wf-primary-soft);
  border-radius: var(--wf-radius-pill);
  background: var(--wf-card);
}
