/* WeFinally 新匹配仪式弹窗 — 被认真安排的感觉，不是普通 toast */
.nmm-mask {
  position: fixed;
  inset: 0;
  z-index: 3000;
  background: var(--wf-mask);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  animation: nmm-fade 0.28s ease-out;
}

.nmm-card {
  position: relative;
  width: 100%;
  max-width: 620rpx;
  background: linear-gradient(168deg, #FDF1F3 0%, #FAF6F4 58%, #FFFFFF 100%);
  border-radius: var(--wf-radius-xl);
  padding: 56rpx 44rpx 40rpx;
  text-align: center;
  overflow: hidden;
  box-shadow: var(--wf-shadow-float);
  animation: nmm-pop 0.34s cubic-bezier(0.22, 1.2, 0.36, 1);
}

.nmm-halo {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}

.nmm-halo.h1 {
  width: 420rpx;
  height: 420rpx;
  right: -180rpx;
  top: -180rpx;
  background: radial-gradient(circle, rgba(232, 99, 127, 0.14), transparent 70%);
}

.nmm-halo.h2 {
  width: 320rpx;
  height: 320rpx;
  left: -150rpx;
  bottom: -120rpx;
  background: radial-gradient(circle, rgba(123, 108, 200, 0.10), transparent 70%);
}

/* 视觉中心：呼吸光环 + 心形 */
.nmm-orb-wrap {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  margin: 0 auto 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nmm-orb-ring {
  position: absolute;
  border-radius: 50%;
  border: 2rpx solid rgba(232, 99, 127, 0.35);
  animation: nmm-breathe 2.2s ease-in-out infinite;
}

.nmm-orb-ring.r1 {
  inset: 0;
}

.nmm-orb-ring.r2 {
  inset: -26rpx;
  border-color: rgba(232, 99, 127, 0.18);
  animation-delay: 0.5s;
}

.nmm-orb {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: var(--wf-primary-grad);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 16rpx 40rpx rgba(232, 99, 127, 0.35);
  animation: nmm-breathe 2.2s ease-in-out infinite;
}

.nmm-orb-icon {
  color: #ffffff;
}

.nmm-kicker {
  font-size: var(--wf-fs-tiny);
  letter-spacing: 4rpx;
  color: var(--wf-text-hint);
  margin-bottom: 12rpx;
}

.nmm-title {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--wf-text-main);
  letter-spacing: 2rpx;
  line-height: 1.4;
}

.nmm-sub {
  font-size: var(--wf-fs-caption);
  color: var(--wf-text-sub);
  margin-top: 10rpx;
}

.nmm-info {
  margin: 32rpx auto 0;
  background: rgba(255, 255, 255, 0.85);
  border: 1rpx solid var(--wf-border);
  border-radius: var(--wf-radius-md);
  padding: 20rpx 28rpx;
  max-width: 460rpx;
}

.nmm-info-main {
  font-size: var(--wf-fs-h2);
  font-weight: 600;
  color: var(--wf-text-main);
}

.nmm-info-meta {
  margin-top: 6rpx;
  font-size: var(--wf-fs-tiny);
  color: var(--wf-text-sub);
  display: flex;
  justify-content: center;
  gap: 16rpx;
}

.nmm-score {
  color: var(--wf-primary-strong);
  font-weight: 600;
}

.nmm-reason {
  margin-top: 24rpx;
  font-size: var(--wf-fs-tiny);
  color: var(--wf-text-hint);
  line-height: 1.7;
}

.nmm-cta {
  margin-top: 36rpx;
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: var(--wf-radius-pill);
  background: var(--wf-primary-grad);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  box-shadow: var(--wf-shadow-cta);
}

.nmm-cta::after {
  border: none;
}

.nmm-later {
  margin-top: 20rpx;
  font-size: var(--wf-fs-caption);
  color: var(--wf-text-sub);
  padding: 12rpx;
}

.nmm-date-cta {
  margin-top: 4rpx;
  font-size: var(--wf-fs-caption);
  color: var(--wf-primary-strong);
  font-weight: 500;
  padding: 8rpx;
}

.nmm-ai-note {
  margin-top: 28rpx;
}

@keyframes nmm-fade {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes nmm-pop {
  from { opacity: 0; transform: scale(0.86) translateY(24rpx); }
  to { opacity: 1; transform: scale(1) translateY(0); }
}

@keyframes nmm-breathe {
  0%, 100% { transform: scale(1); opacity: 1; }
  50% { transform: scale(1.06); opacity: 0.85; }
}
