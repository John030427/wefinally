<view class="qa-panel card" wx:if="{{visible}}">
  <view class="qa-panel-header">
    <text class="qa-panel-badge">内部 QA</text>
    <text class="qa-panel-title">{{title}}</text>
  </view>
  <view class="qa-panel-hint">此处匹配内置合成测试对象，不会触发两台真机账号互配</view>

  <button class="qa-reset-link" wx:if="{{resetVisible}}" bindtap="onResetRegistration" disabled="{{running}}">
    重新注册测试资料
  </button>

  <view class="qa-real-device-block">
    <view class="qa-scenario-label">两台真实微信账号</view>
    <view class="qa-panel-hint">自动检查资料并加入隔离测试组；两台手机都点击后才会互配。再次测试会开启新轮次，旧匹配记录仍保留。</view>
    <button class="qa-btn qa-btn-real" bindtap="onRealDeviceMatch" disabled="{{running}}">
      {{realMatchCompleted ? '再来一轮真机互配' : '两台真机互配测试'}}
    </button>
    <button class="qa-pair-reset" bindtap="onResetQaPairData" disabled="{{running}}">
      清空双机匹配与协调数据
    </button>
    <view class="qa-pair-reset-hint">保留注册资料、画像、会员与订单；清空后两台手机可重新匹配。</view>
  </view>

  <view class="qa-scenario-block" wx:if="{{scenarioPickerVisible}}">
    <view class="qa-scenario-label">测试场景</view>
    <radio-group class="qa-scenario-group" bindchange="onScenarioChange">
      <label
        class="qa-scenario-option {{scenario === item.value ? 'qa-scenario-option-active' : ''}}"
        wx:for="{{scenarios}}"
        wx:key="value"
      >
        <radio value="{{item.value}}" checked="{{scenario === item.value}}" color="#b8860b" />
        <text>{{item.label}}</text>
      </label>
    </radio-group>
  </view>

  <view class="qa-actions qa-synthetic-actions">
    <button
      class="qa-btn qa-btn-outline"
      bindtap="onToggleScenario"
      disabled="{{running || scenarioPickerVisible}}"
    >
      测试合成对象匹配
    </button>
    <button
      class="qa-btn qa-btn-primary"
      bindtap="onSimulateMatch"
      disabled="{{running || !scenarioPickerVisible}}"
      loading="{{running && countdown === 0}}"
    >
      {{countdown > 0 ? countdown + '秒后模拟匹配' : '10秒后模拟匹配'}}
    </button>
  </view>

  <view class="qa-status" wx:if="{{statusText || countdown > 0}}">
    <text wx:if="{{countdown > 0}}">倒计时 {{countdown}} 秒</text>
    <text wx:if="{{statusText}}">{{statusText}}</text>
  </view>
</view>
