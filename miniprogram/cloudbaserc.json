{
  "$schema": "https://static.cloudbase.net/cli/cloudbaserc.schema.json",
  "envId": "cloud1-d4gy8l52g08bba326",
  "functionRoot": "cloudfunctions",
  "functions": [
    {
      "name": "api",
      "timeout": 60,
      "runtime": "Nodejs20.19",
      "handler": "index.main",
      "installDependency": true
    },
    {
      "name": "agent-graph",
      "timeout": 120,
      "runtime": "Nodejs20.19",
      "handler": "index.main",
      "installDependency": true
    },
    {
      "name": "report-worker",
      "timeout": 60,
      "runtime": "Nodejs16.13",
      "handler": "index.main",
      "installDependency": true
    },
    {
      "name": "match-worker",
      "timeout": 60,
      "runtime": "Nodejs20.19",
      "handler": "index.main",
      "installDependency": true,
      "triggers": [
        {
          "name": "formal-match-utc-offset",
          "type": "timer",
          "config": "0 0 16 ? * TUE,THU *"
        }
      ]
    }
  ]
}
