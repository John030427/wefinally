/**
 * WeFinally Icon System — 线性圆角图标（Style A）
 * WEFINALLY_UI_UX_REFACTOR_GOAL_V1 · Stage 2
 *
 * 用法：
 *   <view class="wf-icon wf-icon-heart icon-pink" />
 * 颜色 = background-color（mask 上色），尺寸默认 40rpx，可用 .icon-sm/.icon-lg 调整。
 * 禁止与 emoji 混排在同一层级。
 */

.wf-icon {
  --wf-icon-src: none;
  display: inline-block;
  width: 40rpx;
  height: 40rpx;
  background-color: currentColor;
  -webkit-mask-image: var(--wf-icon-src);
  mask-image: var(--wf-icon-src);
  -webkit-mask-repeat: no-repeat;
  mask-repeat: no-repeat;
  -webkit-mask-position: center;
  mask-position: center;
  -webkit-mask-size: contain;
  mask-size: contain;
  flex-shrink: 0;
}

.icon-sm { width: 32rpx; height: 32rpx; }
.icon-lg { width: 48rpx; height: 48rpx; }
.icon-xl { width: 64rpx; height: 64rpx; }

/* 语义色 */
.icon-pink { color: var(--wf-primary); }
.icon-pink-soft { color: var(--wf-primary-soft); }
.icon-sub { color: var(--wf-text-sub); }
.icon-hint { color: var(--wf-text-hint); }
.icon-white { color: #ffffff; }
.icon-success { color: var(--wf-success); }
.icon-warning { color: var(--wf-warning); }
.icon-danger { color: var(--wf-danger); }
.icon-ai { color: var(--wf-ai); }

