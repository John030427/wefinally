<view class="orders-page container">
  <block wx:if="{{pageState === 'loading'}}">
    <view class="state-wrap"><view class="state-icon">⏳</view><view class="state-text">正在加载订单...</view></view>
  </block>

  <block wx:elif="{{pageState === 'no-network'}}">
    <view class="state-wrap"><view class="state-icon">📡</view><view class="state-text">网络不可用</view><view class="state-btn" bindtap="onRetry">重新加载</view></view>
  </block>

  <block wx:elif="{{pageState === 'error'}}">
    <view class="state-wrap"><view class="state-icon">⚠️</view><view class="state-text">{{errorMsg}}</view><view class="state-btn" bindtap="onRetry">重试</view></view>
  </block>

  <block wx:else>
    <view class="orders-intro">
      <view class="orders-title">我的订单</view>
      <view class="orders-subtitle">查看会员订单、支付结果与发票申请</view>
    </view>

    <view wx:if="{{!orders.length}}" class="empty-card card">
      <view class="empty-icon">🧾</view>
      <view class="empty-title">暂无订单</view>
      <view class="empty-desc">开通或续费 VIP 后，订单会显示在这里</view>
    </view>

    <view wx:for="{{orders}}" wx:key="orderNo" class="order-card card">
      <view class="order-head">
        <view>
          <view class="order-product">VIP 会员 · {{item.vipDays}}天</view>
          <view class="order-created">{{item.createTimeText}}</view>
        </view>
        <view class="order-status {{item.statusClass}}">{{item.statusText}}</view>
      </view>

      <view class="order-amount"><text class="currency">¥</text>{{item.amountText}}</view>

      <view class="order-meta">
        <text class="order-meta-label">订单号</text>
        <text class="order-no" selectable>{{item.orderNo}}</text>
      </view>
      <view wx:if="{{item.payTimeText}}" class="order-meta">
        <text class="order-meta-label">支付时间</text>
        <text>{{item.payTimeText}}</text>
      </view>

      <view class="order-actions">
        <button
          wx:if="{{!item.isPaid}}"
          class="order-btn secondary"
          data-order-no="{{item.orderNo}}"
          bindtap="refreshOrder"
          loading="{{refreshingOrderNo === item.orderNo}}"
          disabled="{{!!refreshingOrderNo}}"
        >刷新状态</button>
        <button
          wx:if="{{item.invoiceEligible}}"
          class="order-btn invoice"
          data-order-no="{{item.orderNo}}"
          bindtap="requestInvoice"
        >申请开发票</button>
        <view wx:if="{{item.invoiceStatusText}}" class="invoice-state {{item.invoiceStatus}}">{{item.invoiceStatusText}}</view>
      </view>
    </view>

    <view class="orders-note">订单支付状态以微信支付和平台确认结果为准</view>
  </block>
</view>
