<view class="partner-login-page container">
  <view class="hero-card card">
    <view class="hero-kicker">WeFinally Partner</view>
    <view class="hero-title">合伙人邀请中心</view>
    <view class="hero-desc">登录后生成安全的邀请链接和小程序码，分享行为不会直接授予会员资格。</view>
  </view>

  <view class="form-card card">
    <view class="form-item">
      <text class="form-label">手机号</text>
      <input class="form-input" type="number" maxlength="20" placeholder="合伙人注册手机号" value="{{phone}}" data-key="phone" bindinput="onInput" />
    </view>
    <view class="form-item">
      <text class="form-label">密码</text>
      <input class="form-input" password placeholder="合伙人后台密码" value="{{password}}" data-key="password" bindinput="onInput" />
    </view>
    <view class="error-text" wx:if="{{errorMsg}}">{{errorMsg}}</view>
    <button class="primary-btn full-btn" bindtap="submit" loading="{{submitting}}" disabled="{{submitting}}">登录并生成邀请</button>
  </view>
</view>
