.partner-activation-page { padding-top:28rpx; }
.hero-card { background:#fff9f7; border:2rpx solid #f0dfe0; margin-bottom:24rpx; }
.hero-kicker,.state-label { color:#c89b52; font-size:20rpx; font-weight:600; letter-spacing:2rpx; }
.hero-title { color:#242126; font-size:42rpx; font-weight:700; margin-top:12rpx; }
.hero-desc,.state-note,.section-desc { color:#766b6f; font-size:24rpx; line-height:1.7; margin-top:14rpx; }
.state-card,.verify-card,.form-card { margin-bottom:24rpx; }
.state-title { color:#242126; font-size:32rpx; font-weight:650; line-height:1.45; margin-top:12rpx; }
.section-title { color:#2f7d62; font-size:29rpx; font-weight:650; }
.form-item { margin-top:22rpx; } .form-label { color:#5d5256; display:block; font-size:24rpx; margin-bottom:10rpx; }
.form-input,.form-textarea { background:#fffaf9; border:1rpx solid #e8d9d6; border-radius:12rpx; box-sizing:border-box; font-size:27rpx; padding:20rpx; width:100%; }
.form-input { height:84rpx; } .form-textarea { min-height:128rpx; }
.full-btn { margin-top:24rpx; width:100%; }
.error-text { color:#b6403a; font-size:24rpx; line-height:1.6; margin:18rpx 0; }
