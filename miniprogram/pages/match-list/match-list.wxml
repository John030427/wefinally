<view class="match-list-page container">
  <block wx:if="{{pageState === 'loading'}}">
    <view class="state-wrap">
      <view class="state-icon">⏳</view>
      <view class="state-text">正在加载...</view>
    </view>
  </block>

  <block wx:elif="{{pageState === 'no-network'}}">
    <view class="state-wrap">
      <view class="state-icon">📡</view>
      <view class="state-text">网络不可用</view>
      <view class="state-btn" bindtap="onRetry">重新加载</view>
    </view>
  </block>

  <block wx:elif="{{pageState === 'error'}}">
    <view class="state-wrap">
      <view class="state-icon">⚠️</view>
      <view class="state-text">{{errorMsg}}</view>
      <view class="state-btn" bindtap="onRetry">重试</view>
    </view>
  </block>

  <block wx:elif="{{pageState === 'empty'}}">
    <view class="state-wrap">
      <view class="state-icon">📋</view>
      <view class="state-text">暂无匹配记录</view>
      <view class="state-hint">VIP 会员将在每周三、周五自动获得匹配</view>
    </view>
  </block>

  <block wx:else>
    <view
      class="list-item card"
      wx:for="{{list}}"
      wx:key="id"
      bindtap="goDetail"
      data-id="{{item.id}}"
    >
      <view class="item-header">
        <text class="item-tag">{{item.matchType || 'AI匹配'}}</text>
        <text class="item-date">{{item.matchDate}}</text>
      </view>
      <view class="item-body">{{item.gender}} · {{item.age}}岁 · {{item.city}}</view>
      <view class="item-score" wx:if="{{item.score !== null}}">
        <text class="tag {{item.scoreTag}}">三观契合 {{item.score}}%</text>
      </view>
      <view class="item-arrow">›</view>
    </view>
  </block>
</view>
