.state-hint {
  font-size: 24rpx;
  color: #bbb;
  margin-top: -16rpx;
}

.qa-panel {
  border: 2rpx dashed #d4a017;
  background: linear-gradient(180deg, #fffdf5 0%, #fff9e8 100%);
  margin-bottom: 24rpx;
}

.qa-panel-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.qa-panel-badge {
  display: inline-block;
  padding: 4rpx 12rpx;
  font-size: 20rpx;
  font-weight: 600;
  color: #8a6d3b;
  background: #fff3cd;
  border-radius: 8rpx;
}

.qa-panel-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #6b4f1d;
}

.qa-panel-hint {
  font-size: 22rpx;
  color: #a68b4b;
  margin-bottom: 20rpx;
}

.qa-scenario-block {
  margin-bottom: 20rpx;
}

.qa-scenario-label {
  font-size: 24rpx;
  color: #8a6d3b;
  margin-bottom: 12rpx;
}

.qa-scenario-group {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.qa-scenario-option {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.7);
  font-size: 26rpx;
  color: #5c4a1f;
}

.qa-scenario-option-active {
  background: #fff;
  box-shadow: inset 0 0 0 2rpx #d4a017;
}

.qa-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.qa-btn {
  border-radius: 48rpx;
  font-size: 28rpx;
  line-height: 80rpx;
  height: 80rpx;
  margin: 0;
  padding: 0 32rpx;
}

.qa-btn::after {
  border: none;
}

.qa-btn-outline {
  background: #fff;
  color: #8a6d3b;
  border: 2rpx solid #d4a017;
}

.qa-btn-outline[disabled] {
  color: #c9b88a;
  border-color: #e8dcc0;
  background: #faf6eb;
}

.qa-btn-primary {
  background: linear-gradient(135deg, #d4a017, #e6b422);
  color: #fff;
  border: none;
}

.qa-btn-primary[disabled] {
  background: #e8dcc0;
  color: #fff;
}

.qa-status {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #8a6d3b;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.list-item {
  position: relative;
  padding-right: 64rpx;
}

.item-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.item-tag {
  font-size: 22rpx;
  color: #ff6b8a;
}

.item-date {
  font-size: 22rpx;
  color: #999;
}

.item-test-badge {
  display: inline-block;
  margin-bottom: 8rpx;
  padding: 4rpx 12rpx;
  font-size: 20rpx;
  color: #8a6d3b;
  background: #fff6e5;
  border-radius: 8rpx;
}

.item-body {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.item-score {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.item-arrow {
  position: absolute;
  right: 32rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 36rpx;
  color: #ccc;
}

.notify-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
  background: #fff;
  border-radius: 16rpx;
}
.notify-entry-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.notify-entry-icon { font-size: 28rpx; }
.notify-entry-title { font-size: 28rpx; font-weight: 600; color: #2f2a26; }
.notify-entry-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.notify-entry-count {
  font-size: 24rpx;
  color: #e34d59;
  font-weight: 600;
}
.notify-entry-badge {
  min-width: 36rpx; height: 36rpx; line-height: 36rpx;
  padding: 0 10rpx; border-radius: 18rpx;
  background: #e34d59; color: #fff; font-size: 22rpx;
  text-align: center; margin-right: 12rpx;
}
.notify-entry-arrow { color: #c9c2bb; font-size: 30rpx; }
.notify-entry-pressed { opacity: 0.85; }
