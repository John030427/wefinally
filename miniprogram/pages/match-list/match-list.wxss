.state-hint {
  font-size: 24rpx;
  color: #bbb;
  margin-top: -16rpx;
}

.list-item {
  position: relative;
  padding-right: 64rpx;
}

.item-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.item-tag {
  font-size: 22rpx;
  color: #ff6b8a;
}

.item-date {
  font-size: 22rpx;
  color: #999;
}

.item-body {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.item-score {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.item-arrow {
  position: absolute;
  right: 32rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 36rpx;
  color: #ccc;
}
