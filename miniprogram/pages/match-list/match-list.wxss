.state-hint {
  font-size: 24rpx;
  color: #bbb;
  margin-top: -16rpx;
}

.list-item {
  position: relative;
  padding-right: 64rpx;
}

.item-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.item-tag {
  font-size: 22rpx;
  color: #ff6b8a;
}

.item-date {
  font-size: 22rpx;
  color: #999;
}

.item-body {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.item-score {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.item-arrow {
  position: absolute;
  right: 32rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 36rpx;
  color: #ccc;
}

.notify-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
  background: #fff;
  border-radius: 16rpx;
}
.notify-entry-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.notify-entry-icon { font-size: 28rpx; }
.notify-entry-title { font-size: 28rpx; font-weight: 600; color: #2f2a26; }
.notify-entry-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.notify-entry-count {
  font-size: 24rpx;
  color: #e34d59;
  font-weight: 600;
}
.notify-entry-badge {
  min-width: 36rpx; height: 36rpx; line-height: 36rpx;
  padding: 0 10rpx; border-radius: 18rpx;
  background: #e34d59; color: #fff; font-size: 22rpx;
  text-align: center; margin-right: 12rpx;
}
.notify-entry-arrow { color: #c9c2bb; font-size: 30rpx; }
.notify-entry-pressed { opacity: 0.85; }
