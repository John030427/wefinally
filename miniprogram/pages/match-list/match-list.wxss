/* 匹配记录 — 精选结果列表，状态一眼可辨 */
.match-list-page {
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.row-card-pressed {
  opacity: 0.85;
  transform: scale(0.99);
}

/* ===== 通知入口 ===== */

.notify-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 32rpx;
}

.notify-entry-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.notify-entry-icon {
  position: relative;
  width: 68rpx;
  height: 68rpx;
  border-radius: var(--wf-radius-md);
  background: var(--wf-primary-soft-2);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--wf-primary);
}

.notify-entry-dot {
  position: absolute;
  right: -4rpx;
  top: -4rpx;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: var(--wf-danger);
  border: 3rpx solid var(--wf-card);
}

.notify-entry-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--wf-text-main);
}

.notify-entry-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.notify-entry-count {
  font-size: var(--wf-fs-caption);
  color: var(--wf-primary-strong);
  font-weight: 500;
}

/* ===== 列表提示 ===== */

.list-tip {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin: 4rpx 8rpx 20rpx;
  font-size: var(--wf-fs-tiny);
  color: var(--wf-text-hint);
}

.list-tip-icon {
  color: var(--wf-ai);
}

/* ===== 匹配卡片 ===== */

.list-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx 32rpx;
}

.item-main {
  flex: 1;
  min-width: 0;
}

.item-header {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.tag-new {
  background: var(--wf-primary-grad);
  color: #ffffff;
  font-weight: 600;
}

.item-date {
  margin-left: auto;
  font-size: var(--wf-fs-tiny);
  color: var(--wf-text-hint);
}

.item-body {
  margin-top: 14rpx;
  font-size: var(--wf-fs-h2);
  font-weight: 600;
  color: var(--wf-text-main);
}

.item-score {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
}

.item-arrow {
  flex-shrink: 0;
}

/* ===== 内部测试抽屉 ===== */

.qa-drawer {
  margin-top: 40rpx;
  border: 2rpx dashed var(--wf-border);
  border-radius: var(--wf-radius-md);
  overflow: hidden;
}

.qa-drawer-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 28rpx;
  background: #F7F2F0;
}

.qa-drawer-title {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: var(--wf-fs-caption);
  color: var(--wf-text-sub);
}

.qa-drawer-toggle {
  font-size: var(--wf-fs-tiny);
  color: var(--wf-text-hint);
}

.qa-drawer-body {
  padding: 8rpx;
}
