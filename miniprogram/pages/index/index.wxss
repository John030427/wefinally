.index-page .hero-card {
  background: linear-gradient(135deg, #ff6b8a 0%, #ff8fa3 100%);
  color: #fff;
}

.hero-title {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.hero-desc {
  font-size: 24rpx;
  opacity: 0.9;
  line-height: 1.6;
  margin-bottom: 24rpx;
}

.next-match {
  background: rgba(255, 255, 255, 0.2);
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
}

.next-label {
  display: block;
  font-size: 22rpx;
  opacity: 0.85;
  margin-bottom: 8rpx;
}

.next-value {
  font-size: 30rpx;
  font-weight: 600;
}

.dev-match-btn {
  margin: 20rpx 0 0;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 12rpx;
  background: #fff;
  color: #ff5f82;
  font-size: 26rpx;
  font-weight: 600;
  padding: 0;
}

.dev-match-btn::after {
  border: none;
}

.dev-reset-btn {
  margin: 18rpx 0 0;
  height: 68rpx;
  line-height: 68rpx;
  border-radius: 8rpx;
  background: #ffffff;
  border: 2rpx solid #ff6b8a;
  color: #ff6b8a;
  font-size: 24rpx;
  padding: 0;
}

.dev-reset-btn::after {
  border: none;
}

.vip-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.vip-banner-text {
  flex: 1;
  font-size: 26rpx;
  color: #555;
}

.btn-sm {
  line-height: 64rpx !important;
  height: 64rpx !important;
  font-size: 24rpx !important;
  padding: 0 28rpx !important;
  flex-shrink: 0;
}

.vip-active {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.safety-home {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: #fff;
}

.safety-main {
  flex: 1;
  min-width: 0;
}

.safety-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.safety-desc {
  font-size: 24rpx;
  color: #888;
  line-height: 1.5;
}

.safety-call {
  width: 108rpx;
  height: 72rpx;
  border-radius: 36rpx;
  background: #ff6b8a;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  flex: 0 0 108rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.love-advisor-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border: 2rpx solid #ffe0e7;
}

.love-advisor-copy {
  min-width: 0;
}

.love-advisor-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.love-advisor-desc {
  font-size: 24rpx;
  color: #888;
  line-height: 1.5;
}

.love-advisor-arrow {
  flex: 0 0 auto;
  color: #ff6b8a;
  font-size: 44rpx;
  line-height: 1;
}

.vip-badge {
  background: #fff0f3;
  color: #ff6b8a;
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.vip-expire {
  font-size: 24rpx;
  color: #888;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 8rpx 0 16rpx;
  padding: 0 8rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.section-link {
  font-size: 24rpx;
  color: #ff6b8a;
}

.match-card {
  position: relative;
}

.match-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.match-tag {
  font-size: 22rpx;
  color: #ff6b8a;
  background: #fff0f3;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.match-date {
  font-size: 22rpx;
  color: #999;
}

.match-info {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.match-score {
  font-size: 26rpx;
  color: #2ecc71;
  font-weight: 500;
}

.match-link {
  position: absolute;
  right: 32rpx;
  bottom: 32rpx;
  font-size: 24rpx;
  color: #ff6b8a;
}

.empty-card {
  text-align: center;
  padding: 48rpx 32rpx;
}

.empty-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #999;
}

.quick-actions {
  display: flex;
  gap: 24rpx;
}

.action-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx;
}

.action-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.action-text {
  font-size: 24rpx;
  color: #555;
}

.notice {
  background: #fafafa;
}

.notice-text {
  display: block;
  font-size: 22rpx;
  color: #999;
  line-height: 1.8;
}
