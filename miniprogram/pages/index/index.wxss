.index-page {
  background: #fff9f6;
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
}

.journey-band {
  position: relative;
  overflow: hidden;
  margin-bottom: 24rpx;
  padding: 28rpx 30rpx 30rpx;
  border: 2rpx solid #f0dce1;
  border-radius: 28rpx;
  background: linear-gradient(120deg, #fff8f4 0%, #fff1f4 100%);
  box-shadow: 0 12rpx 32rpx rgba(169, 67, 90, 0.07);
}

.journey-band::after {
  content: "";
  position: absolute;
  top: -42rpx;
  right: -34rpx;
  width: 148rpx;
  height: 148rpx;
  border: 24rpx solid #fff0f3;
  border-radius: 50%;
  opacity: 0.76;
}

.journey-status {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 14rpx;
  color: #3e8e6b;
  font-size: 21rpx;
  font-weight: 650;
  letter-spacing: 2rpx;
}

.journey-status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #3e8e6b;
  box-shadow: 0 0 0 8rpx #e8f4ed;
}

.journey-body {
  position: relative;
  z-index: 1;
  margin-top: 24rpx;
  padding-left: 26rpx;
  border-left: 2rpx solid #eadfe1;
}

.journey-kicker {
  margin-bottom: 10rpx;
  color: #a9435a;
  font-size: 21rpx;
  font-weight: 650;
  letter-spacing: 1rpx;
}

.journey-title {
  max-width: 510rpx;
  color: #231f20;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.35;
}

.journey-desc {
  max-width: 520rpx;
  margin-top: 10rpx;
  color: #746b6d;
  font-size: 24rpx;
  line-height: 1.65;
}

.journey-action {
  display: inline-flex;
  align-items: center;
  gap: 14rpx;
  height: 58rpx;
  margin: 20rpx 0 0;
  padding: 0;
  border-radius: 0;
  background: transparent;
  color: #231f20;
  font-size: 25rpx;
  font-weight: 650;
  line-height: 58rpx;
  text-align: left;
}

.journey-action::after {
  border: 0;
}

.journey-action-arrow {
  color: #ff6b8a;
  font-size: 30rpx;
  font-weight: 500;
}

.match-stage {
  position: relative;
  overflow: hidden;
  margin-bottom: 24rpx;
  padding: 34rpx 32rpx 30rpx;
  border: 2rpx solid #efd9df;
  border-radius: 30rpx;
  background: linear-gradient(140deg, #ffe8ee 0%, #fff8f4 56%, #e8f4ed 100%);
  color: #231f20;
  box-shadow: 0 18rpx 42rpx rgba(169, 67, 90, 0.09);
}

.match-stage-orbit {
  position: absolute;
  border: 2rpx solid rgba(255, 107, 138, 0.16);
  border-radius: 50%;
  pointer-events: none;
}

.orbit-large {
  right: -130rpx;
  bottom: -96rpx;
  width: 420rpx;
  height: 250rpx;
  transform: rotate(-18deg);
}

.orbit-small {
  right: 24rpx;
  bottom: -116rpx;
  width: 220rpx;
  height: 280rpx;
  border-color: rgba(62, 142, 107, 0.16);
  transform: rotate(24deg);
}

.match-stage-head {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.match-stage-kicker {
  color: #a9435a;
  font-size: 22rpx;
  font-weight: 650;
  letter-spacing: 3rpx;
}

.match-stage-frequency {
  padding: 8rpx 16rpx;
  border: 2rpx solid rgba(169, 67, 90, 0.14);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.58);
  color: #8e4a5a;
  font-size: 20rpx;
  letter-spacing: 1rpx;
}

.match-stage-time {
  position: relative;
  z-index: 1;
  max-width: 520rpx;
  margin-top: 24rpx;
  font-size: 39rpx;
  font-weight: 700;
  line-height: 1.35;
  letter-spacing: 1rpx;
}

.match-stage-desc {
  position: relative;
  z-index: 1;
  max-width: 510rpx;
  margin-top: 12rpx;
  color: #746b6d;
  font-size: 23rpx;
  line-height: 1.6;
}

.match-stage-note {
  position: relative;
  z-index: 1;
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  max-width: 510rpx;
  margin-top: 26rpx;
  padding: 12rpx 18rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.68);
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.52);
  color: #4f484a;
  font-size: 22rpx;
  line-height: 1.5;
}

.match-stage-note-dot {
  flex: 0 0 auto;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #7ccba3;
  box-shadow: 0 0 0 7rpx rgba(124, 203, 163, 0.12);
}

.dev-match-row {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid rgba(169, 67, 90, 0.12);
}

.dev-match-label {
  color: #93888b;
  font-size: 20rpx;
  letter-spacing: 2rpx;
}

.dev-match-btn {
  height: 64rpx;
  margin: 0;
  padding: 0 24rpx;
  border-radius: 32rpx;
  background: #ff6b8a;
  color: #fff;
  font-size: 23rpx;
  font-weight: 650;
  line-height: 64rpx;
}

.dev-match-btn::after {
  border: 0;
}

.dev-reset-btn {
  margin: 18rpx 0 0;
  height: 68rpx;
  line-height: 68rpx;
  border-radius: 8rpx;
  background: #ffffff;
  border: 2rpx solid #ff6b8a;
  color: #ff6b8a;
  font-size: 24rpx;
  padding: 0;
}

.dev-reset-btn::after {
  border: none;
}

.vip-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.vip-banner-text {
  flex: 1;
  font-size: 26rpx;
  color: #555;
}

.btn-sm {
  line-height: 64rpx !important;
  height: 64rpx !important;
  font-size: 24rpx !important;
  padding: 0 28rpx !important;
  flex-shrink: 0;
}

.vip-active {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.safety-home {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: #fff;
}

.safety-main {
  flex: 1;
  min-width: 0;
}

.safety-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.safety-desc {
  font-size: 24rpx;
  color: #888;
  line-height: 1.5;
}

.safety-call {
  width: 108rpx;
  height: 72rpx;
  border-radius: 36rpx;
  background: #ff6b8a;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  flex: 0 0 108rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.love-advisor-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border: 2rpx solid #ffe0e7;
}

.love-advisor-copy {
  min-width: 0;
}

.love-advisor-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.love-advisor-desc {
  font-size: 24rpx;
  color: #888;
  line-height: 1.5;
}

.love-advisor-arrow {
  flex: 0 0 auto;
  color: #ff6b8a;
  font-size: 44rpx;
  line-height: 1;
}

.vip-badge {
  background: #fff0f3;
  color: #ff6b8a;
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.vip-expire {
  font-size: 24rpx;
  color: #888;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 8rpx 0 16rpx;
  padding: 0 8rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.section-link {
  font-size: 24rpx;
  color: #ff6b8a;
}

.match-card {
  position: relative;
}

.match-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.match-tag {
  font-size: 22rpx;
  color: #ff6b8a;
  background: #fff0f3;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.match-date {
  font-size: 22rpx;
  color: #999;
}

.match-info {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.match-score {
  font-size: 26rpx;
  color: #2ecc71;
  font-weight: 500;
}

.match-link {
  position: absolute;
  right: 32rpx;
  bottom: 32rpx;
  font-size: 24rpx;
  color: #ff6b8a;
}

.empty-card {
  text-align: center;
  padding: 48rpx 32rpx;
}

.empty-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #999;
}

.quick-actions {
  display: flex;
  gap: 24rpx;
}

.action-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx;
}

.action-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.action-text {
  font-size: 24rpx;
  color: #555;
}

.notice {
  background: #fafafa;
}

.notice-text {
  display: block;
  font-size: 22rpx;
  color: #999;
  line-height: 1.8;
}
