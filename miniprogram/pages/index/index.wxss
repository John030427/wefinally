/* 首页 — Style A 轻奢柔粉 · 主线：我在哪一步 → 下一次什么时候 → 现在点哪 */
.index-page {
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

/* ===== 主线 Hero ===== */

.journey-band {
  position: relative;
  overflow: hidden;
  background: linear-gradient(135deg, #F9DEE4, #FDF1F3 55%, #FFFFFF);
  border: 1rpx solid rgba(240, 228, 228, 0.8);
  border-radius: var(--wf-radius-xl);
  padding: 36rpx 32rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--wf-shadow-card);
}

.journey-halo {
  position: absolute;
  right: -120rpx;
  top: -120rpx;
  width: 320rpx;
  height: 320rpx;
  border-radius: 50%;
  border: 28rpx solid rgba(232, 99, 127, 0.08);
  pointer-events: none;
}

.journey-status {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: var(--wf-fs-tiny);
  letter-spacing: 2rpx;
  color: var(--wf-primary-strong);
  margin-bottom: 14rpx;
  font-weight: 600;
}

.journey-status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--wf-primary);
  animation: wf-home-pulse 2s ease-in-out infinite;
}

.journey-title {
  font-size: var(--wf-fs-h1);
  font-weight: 700;
  color: var(--wf-text-main);
  line-height: 1.35;
}

.journey-desc {
  margin-top: 8rpx;
  font-size: var(--wf-fs-caption);
  color: var(--wf-text-sub);
  line-height: 1.6;
}

.journey-action {
  margin-top: 26rpx;
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  background: var(--wf-primary-grad);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: var(--wf-radius-pill);
  padding: 18rpx 36rpx;
  box-shadow: var(--wf-shadow-cta);
}

.journey-action-arrow {
  color: #ffffff;
}

.journey-action-pressed {
  opacity: 0.88;
  transform: scale(0.98);
}

/* ===== 下一次介绍 ===== */

.match-stage {
  position: relative;
  overflow: hidden;
  background: var(--wf-card);
  border: 1rpx solid rgba(240, 228, 228, 0.6);
  border-radius: var(--wf-radius-xl);
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--wf-shadow-card);
}

.match-stage-orbit {
  position: absolute;
  border-radius: 50%;
  border: 2rpx solid rgba(232, 99, 127, 0.14);
  pointer-events: none;
}

.match-stage-orbit.orbit-large {
  width: 360rpx;
  height: 360rpx;
  right: -140rpx;
  top: -140rpx;
}

.match-stage-orbit.orbit-small {
  width: 200rpx;
  height: 200rpx;
  right: -60rpx;
  top: -60rpx;
}

.match-stage-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.match-stage-kicker {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: var(--wf-fs-caption);
  color: var(--wf-text-sub);
}

.match-stage-kicker-icon {
  color: var(--wf-primary);
}

.match-stage-frequency {
  font-size: var(--wf-fs-tiny);
  color: var(--wf-text-hint);
  background: var(--wf-primary-soft-2);
  border-radius: var(--wf-radius-pill);
  padding: 6rpx 20rpx;
}

.match-stage-time {
  font-size: 52rpx;
  font-weight: 700;
  color: var(--wf-text-main);
  letter-spacing: 1rpx;
  line-height: 1.3;
}

.match-stage-desc {
  margin-top: 6rpx;
  font-size: var(--wf-fs-caption);
  color: var(--wf-text-sub);
}

.match-stage-note {
  margin-top: 22rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: var(--wf-fs-tiny);
  color: var(--wf-text-hint);
}

.match-stage-note-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--wf-success);
  flex-shrink: 0;
}

/* ===== VIP ===== */

.vip-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 28rpx 32rpx;
}

.vip-banner-copy {
  flex: 1;
  min-width: 0;
}

.vip-banner-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--wf-text-main);
}

.vip-banner-desc {
  margin-top: 6rpx;
  font-size: var(--wf-fs-tiny);
  color: var(--wf-text-hint);
}

.vip-banner-btn {
  flex-shrink: 0;
}

.vip-active-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.vip-active-icon {
  color: var(--wf-warning);
}

.vip-badge {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--wf-text-main);
}

.vip-expire {
  font-size: var(--wf-fs-tiny);
  color: var(--wf-text-hint);
  margin-left: auto;
}

/* ===== AI 恋爱助手入口 ===== */

.love-advisor-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx 32rpx;
}

.love-advisor-icon {
  width: 84rpx;
  height: 84rpx;
  border-radius: var(--wf-radius-md);
  background: var(--wf-ai-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.love-advisor-icon-glyph {
  color: var(--wf-ai);
}

.love-advisor-copy {
  flex: 1;
}

.love-advisor-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--wf-text-main);
}

.love-advisor-desc {
  margin-top: 4rpx;
  font-size: var(--wf-fs-caption);
  color: var(--wf-text-sub);
}

.row-card-pressed {
  opacity: 0.85;
  transform: scale(0.99);
}

/* ===== 最近匹配 ===== */

.section-header-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--wf-text-main);
}

.match-card {
  padding: 28rpx 32rpx;
}

.match-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.match-date {
  font-size: var(--wf-fs-tiny);
  color: var(--wf-text-hint);
}

.match-info {
  margin-top: 14rpx;
  font-size: var(--wf-fs-h2);
  font-weight: 600;
  color: var(--wf-text-main);
}

.match-footer {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.match-score {
  font-size: var(--wf-fs-caption);
  color: var(--wf-primary-strong);
  font-weight: 600;
  background: var(--wf-primary-soft);
  border-radius: var(--wf-radius-pill);
  padding: 6rpx 20rpx;
}

.match-link {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: var(--wf-fs-caption);
  color: var(--wf-text-sub);
}

.empty-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 32rpx;
}

.empty-icon {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: var(--wf-primary-soft-2);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--wf-primary);
  opacity: 0.8;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--wf-text-main);
}

.empty-hint {
  margin-top: 8rpx;
  font-size: var(--wf-fs-caption);
  color: var(--wf-text-hint);
}

/* ===== 安全求助 ===== */

.safety-home {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx 32rpx;
}

.safety-main {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
  min-width: 0;
}

.safety-icon {
  width: 84rpx;
  height: 84rpx;
  border-radius: var(--wf-radius-md);
  background: var(--wf-primary-soft-2);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.safety-icon-glyph {
  color: var(--wf-primary);
}

.safety-copy {
  flex: 1;
  min-width: 0;
}

.safety-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--wf-text-main);
}

.safety-desc {
  margin-top: 4rpx;
  font-size: var(--wf-fs-tiny);
  color: var(--wf-text-sub);
  line-height: 1.5;
}

.safety-call {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
  width: 104rpx;
  height: 104rpx;
  border-radius: var(--wf-radius-md);
  background: var(--wf-danger-soft);
  color: var(--wf-danger);
  font-size: var(--wf-fs-caption);
  font-weight: 700;
  flex-shrink: 0;
}

.safety-call-pressed {
  opacity: 0.8;
}

/* ===== 快捷入口 ===== */

.quick-actions {
  display: flex;
  padding: 28rpx 16rpx;
}

.action-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.action-item-pressed {
  opacity: 0.7;
}

.action-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  border-radius: var(--wf-radius-md);
  background: var(--wf-primary-soft-2);
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-icon {
  color: var(--wf-primary);
}

.action-text {
  font-size: var(--wf-fs-caption);
  color: var(--wf-text-main);
}

/* ===== 说明 ===== */

.notice {
  padding: 24rpx 32rpx;
}

.notice-text {
  display: block;
  font-size: var(--wf-fs-tiny);
  color: var(--wf-text-hint);
  line-height: 1.9;
}

/* ===== 内部测试抽屉（与正式用户视图隔离） ===== */

.qa-drawer {
  margin-top: 40rpx;
  border: 2rpx dashed var(--wf-border);
  border-radius: var(--wf-radius-md);
  overflow: hidden;
}

.qa-drawer-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 28rpx;
  background: #F7F2F0;
}

.qa-drawer-title {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: var(--wf-fs-caption);
  color: var(--wf-text-sub);
}

.qa-drawer-toggle {
  font-size: var(--wf-fs-tiny);
  color: var(--wf-text-hint);
}

.qa-drawer-body {
  padding: 8rpx;
}

@keyframes wf-home-pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.5; transform: scale(0.8); }
}
