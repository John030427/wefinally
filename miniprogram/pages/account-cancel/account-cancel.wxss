.warn-card {
  background: #fff5f5;
}

.warn-item {
  display: block;
  font-size: 26rpx;
  color: #c62828;
  line-height: 1.8;
}

.confirm-row {
  display: flex;
  align-items: center;
  padding: 32rpx 0;
}

.checkbox {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid #ccc;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  font-size: 24rpx;
  color: #fff;
  flex-shrink: 0;
}

.checkbox.checked {
  background: #ff6b8a;
  border-color: #ff6b8a;
}

.confirm-label {
  font-size: 26rpx;
  color: #555;
}
