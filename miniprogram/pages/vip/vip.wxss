.vip-hero {
  background: linear-gradient(135deg, #ff6b8a, #ffb3c1);
  color: #fff;
  text-align: center;
  padding: 48rpx 32rpx;
}

.vip-hero-title {
  font-size: 32rpx;
  margin-bottom: 16rpx;
}

.vip-price-row {
  display: flex;
  align-items: baseline;
  justify-content: center;
  margin-bottom: 12rpx;
}

.vip-price {
  font-size: 72rpx;
  font-weight: 700;
}

.vip-period {
  font-size: 28rpx;
  margin-left: 8rpx;
}

.vip-note {
  font-size: 22rpx;
  opacity: 0.9;
}

.vip-status {
  margin-top: 20rpx;
  font-size: 24rpx;
}

.vip-active-tag {
  background: rgba(255, 255, 255, 0.3);
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  margin-right: 12rpx;
}

.benefits-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
}

.benefit-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 28rpx;
}

.benefit-item:last-child {
  margin-bottom: 0;
}

.benefit-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.benefit-content {
  flex: 1;
}

.benefit-name {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 4rpx;
}

.benefit-desc {
  font-size: 24rpx;
  color: #888;
}
