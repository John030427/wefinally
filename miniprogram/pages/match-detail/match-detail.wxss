/* 匹配详情 — 决策顺序：状态头 → 为什么值得了解 → AI报告 → 反馈 → 细节(折叠) → 行动 */
.match-detail-page {
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
}

.row-card-pressed {
  opacity: 0.85;
  transform: scale(0.99);
}

/* ===== 1. 状态头 ===== */

.meta-card {
  padding: 32rpx;
}

.meta-hero {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.meta-orb {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--wf-primary-grad);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 26rpx rgba(232, 99, 127, 0.28);
  flex-shrink: 0;
}

.meta-orb-icon {
  color: #ffffff;
}

.meta-head-copy {
  flex: 1;
  min-width: 0;
}

.meta-kicker {
  font-size: var(--wf-fs-tiny);
  letter-spacing: 2rpx;
  color: var(--wf-text-hint);
}

.meta-title-row {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-top: 6rpx;
}

.meta-title {
  font-size: var(--wf-fs-h1);
  font-weight: 700;
  color: var(--wf-text-main);
}

.meta-date {
  font-size: var(--wf-fs-tiny);
  color: var(--wf-text-hint);
}

.profile-tags {
  display: flex;
  flex-wrap: wrap;
}

/* 锁定态 */
.lock-box {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: var(--wf-primary-soft-2);
  border-radius: var(--wf-radius-md);
  padding: 24rpx;
}

.lock-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--wf-card);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--wf-warning);
  flex-shrink: 0;
}

.lock-copy {
  flex: 1;
}

.lock-text {
  display: block;
  font-size: var(--wf-fs-caption);
  color: var(--wf-text-main);
  line-height: 1.6;
}

.lock-btn {
  margin-top: 14rpx;
}

/* ===== 2. 为什么值得了解 ===== */

.summary-card {
  background: linear-gradient(160deg, #FFFFFF 0%, #FDF6F4 100%);
}

.summary-kicker {
  font-size: var(--wf-fs-tiny);
  letter-spacing: 2rpx;
  color: var(--wf-text-hint);
}

.summary-title {
  margin-top: 6rpx;
  font-size: var(--wf-fs-h2);
  font-weight: 700;
  color: var(--wf-text-main);
}

.summary-group {
  margin-top: 24rpx;
  background: var(--wf-card);
  border: 1rpx solid var(--wf-border);
  border-radius: var(--wf-radius-md);
  padding: 22rpx 24rpx;
}

.summary-group.good {
  border-left: 6rpx solid var(--wf-success);
}

.summary-group.caution {
  border-left: 6rpx solid var(--wf-warning);
}

.summary-group.limitation {
  border-left: 6rpx solid #D8CCCC;
}

.summary-label {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: var(--wf-fs-caption);
  font-weight: 600;
  color: var(--wf-text-main);
  margin-bottom: 10rpx;
}

.summary-label-icon.good { color: var(--wf-success); }
.summary-label-icon.caution { color: var(--wf-warning); }
.summary-label-icon.limitation { color: var(--wf-text-hint); }

.summary-line {
  position: relative;
  padding-left: 24rpx;
  font-size: var(--wf-fs-caption);
  color: var(--wf-text-main);
  line-height: 1.7;
  margin-top: 6rpx;
}

.summary-line::before {
  content: '';
  position: absolute;
  left: 6rpx;
  top: 14rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--wf-primary-soft);
}

/* ===== 3. AI 匹配报告 ===== */

.report-card {
  padding: 28rpx 28rpx 24rpx;
}

.report-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.report-title {
  font-size: var(--wf-fs-h2);
  font-weight: 700;
  color: var(--wf-text-main);
}

.report-ai-tag {
  margin-top: 10rpx;
}

.report-status {
  flex-shrink: 0;
  font-size: var(--wf-fs-tiny);
  font-weight: 600;
  padding: 6rpx 20rpx;
  border-radius: var(--wf-radius-pill);
  background: #F5F0EE;
  color: var(--wf-text-sub);
}

.report-status.running {
  background: var(--wf-ai-soft);
  color: var(--wf-ai);
}

.report-status.ready {
  background: var(--wf-success-soft);
  color: var(--wf-success);
}

.report-hint-line {
  font-size: var(--wf-fs-caption);
  color: var(--wf-text-sub);
  line-height: 1.7;
  padding: 8rpx 4rpx;
}

/* 报告正文：块状阅读 */
.structured-report {
  border-top: 1rpx solid var(--wf-border);
  padding-top: 24rpx;
}

.report-lead {
  font-size: var(--wf-fs-body);
  font-weight: 600;
  color: var(--wf-text-main);
  line-height: 1.8;
  background: var(--wf-primary-soft-2);
  border-radius: var(--wf-radius-md);
  padding: 22rpx 24rpx;
  margin-bottom: 24rpx;
}

.report-section {
  margin-bottom: 28rpx;
}

.report-section-head {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 14rpx;
}

.report-section-index {
  width: 40rpx;
  height: 40rpx;
  border-radius: 12rpx;
  background: var(--wf-primary-soft);
  color: var(--wf-primary-strong);
  font-size: var(--wf-fs-tiny);
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.report-section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--wf-text-main);
}

.report-group {
  background: #FCF8F7;
  border-radius: var(--wf-radius-sm);
  padding: 18rpx 22rpx;
  margin-bottom: 12rpx;
}

.report-group-label {
  font-size: var(--wf-fs-tiny);
  font-weight: 600;
  color: var(--wf-primary-strong);
  margin-bottom: 8rpx;
}

.report-item {
  position: relative;
  padding-left: 26rpx;
  font-size: var(--wf-fs-caption);
  color: var(--wf-text-main);
  line-height: 1.8;
  margin-top: 6rpx;
}

.report-item::before {
  content: '';
  position: absolute;
  left: 6rpx;
  top: 16rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--wf-primary-soft);
}

.report-text {
  font-size: var(--wf-fs-caption);
  color: var(--wf-text-main);
  line-height: 1.9;
}

.report-section-title-fallback {
  margin: 22rpx 0 8rpx;
  font-size: var(--wf-fs-caption);
  font-weight: 600;
  color: var(--wf-primary-strong);
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.report-section-title-fallback::before {
  content: '';
  width: 6rpx;
  height: 24rpx;
  border-radius: 3rpx;
  background: var(--wf-primary);
}

/* 失败态 */
.report-failed {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  background: var(--wf-danger-soft);
  border-radius: var(--wf-radius-md);
  padding: 24rpx;
}

.report-failed-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--wf-card);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--wf-danger);
  flex-shrink: 0;
}

.report-failed-copy {
  flex: 1;
}

.report-failed-title {
  display: block;
  font-size: var(--wf-fs-body);
  font-weight: 600;
  color: var(--wf-text-main);
}

.report-failed-desc {
  display: block;
  margin-top: 6rpx;
  font-size: var(--wf-fs-tiny);
  color: var(--wf-text-sub);
  line-height: 1.6;
}

.local-report-box {
  margin-top: 20rpx;
  background: #FCF8F7;
  border: 1rpx dashed var(--wf-border);
  border-radius: var(--wf-radius-sm);
  padding: 20rpx 24rpx;
}

.local-report-title {
  font-size: var(--wf-fs-tiny);
  font-weight: 600;
  color: var(--wf-text-sub);
  margin-bottom: 8rpx;
}

.report-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.report-action-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: var(--wf-radius-pill);
  background: var(--wf-card);
  color: var(--wf-primary);
  font-size: var(--wf-fs-caption);
  font-weight: 600;
  border: 2rpx solid var(--wf-primary-soft);
  padding: 0;
}

.report-action-btn.primary {
  background: var(--wf-primary-grad);
  color: #ffffff;
  border: none;
  box-shadow: var(--wf-shadow-cta);
}

.report-action-btn::after {
  border: none;
}

/* ===== 4. 感受反馈 ===== */

.feedback-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.feedback-kicker {
  font-size: var(--wf-fs-tiny);
  color: var(--wf-text-hint);
  letter-spacing: 2rpx;
}

.feedback-title {
  margin-top: 6rpx;
  font-size: var(--wf-fs-h2);
  font-weight: 700;
  color: var(--wf-text-main);
}

.saved-pill {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  flex-shrink: 0;
  font-size: var(--wf-fs-tiny);
  color: var(--wf-success);
  background: var(--wf-success-soft);
  border-radius: var(--wf-radius-pill);
  padding: 6rpx 18rpx;
}

.feedback-options {
  display: flex;
  gap: 14rpx;
  margin-top: 22rpx;
}

.feedback-option {
  flex: 1;
  text-align: center;
  padding: 18rpx 8rpx;
  border-radius: var(--wf-radius-sm);
  border: 2rpx solid var(--wf-border);
  font-size: var(--wf-fs-caption);
  color: var(--wf-text-sub);
  background: var(--wf-card);
}

.feedback-option.selected {
  border-color: var(--wf-primary);
  color: var(--wf-primary-strong);
  background: var(--wf-primary-soft-2);
  font-weight: 600;
}

.feedback-purpose {
  margin-top: 14rpx;
  font-size: var(--wf-fs-tiny);
  color: var(--wf-text-hint);
  line-height: 1.6;
}

.feedback-subtitle {
  margin-top: 24rpx;
  font-size: var(--wf-fs-caption);
  font-weight: 600;
  color: var(--wf-text-main);
}

.feedback-reasons {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 14rpx;
}

.reason-chip {
  padding: 12rpx 26rpx;
  border-radius: var(--wf-radius-pill);
  border: 2rpx solid var(--wf-border);
  font-size: var(--wf-fs-caption);
  color: var(--wf-text-sub);
  background: var(--wf-card);
}

.reason-chip.selected {
  border-color: var(--wf-primary);
  background: var(--wf-primary-soft-2);
  color: var(--wf-primary-strong);
  font-weight: 600;
}

.feedback-note {
  width: 100%;
  min-height: 140rpx;
  margin-top: 20rpx;
  background: var(--wf-primary-soft-2);
  border-radius: var(--wf-radius-sm);
  padding: 20rpx 24rpx;
  font-size: var(--wf-fs-caption);
  box-sizing: border-box;
}

.review-row {
  margin-top: 16rpx;
  font-size: var(--wf-fs-caption);
  color: var(--wf-text-main);
}

.feedback-submit {
  margin-top: 24rpx;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: var(--wf-radius-pill);
  background: var(--wf-primary-grad);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  box-shadow: var(--wf-shadow-cta);
}

.feedback-submit::after {
  border: none;
}

/* ===== 5. 算法细节 ===== */

.algorithm-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 26rpx 32rpx;
}

.algorithm-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--wf-text-main);
}

.algorithm-desc {
  margin-top: 4rpx;
  font-size: var(--wf-fs-tiny);
  color: var(--wf-text-hint);
}

.algorithm-action {
  flex-shrink: 0;
  font-size: var(--wf-fs-caption);
  color: var(--wf-text-sub);
}

.compat-card {
  padding: 28rpx 32rpx;
}

.compat-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--wf-text-main);
  margin-bottom: 16rpx;
}

.compat-score-row {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}

.compat-score-num {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--wf-primary-strong);
}

.total-score-value {
  font-size: var(--wf-fs-caption);
  color: var(--wf-text-sub);
}

.compat-hint {
  font-size: var(--wf-fs-tiny);
  color: var(--wf-text-sub);
  line-height: 1.7;
  margin-top: 8rpx;
}

.semantic-score-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx 24rpx;
  font-size: var(--wf-fs-caption);
  color: var(--wf-text-main);
  font-weight: 500;
}

.semantic-metrics {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 24rpx;
  margin-top: 8rpx;
  font-size: var(--wf-fs-tiny);
  color: var(--wf-text-sub);
}

.semantic-group {
  margin-top: 20rpx;
}

.breakdown-row {
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--wf-border);
}

.breakdown-row:last-of-type {
  border-bottom: none;
}

.breakdown-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.breakdown-label {
  font-size: var(--wf-fs-caption);
  font-weight: 500;
  color: var(--wf-text-main);
}

.breakdown-value {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.breakdown-score {
  font-size: var(--wf-fs-caption);
  color: var(--wf-text-sub);
}

.breakdown-arrow {
  font-size: var(--wf-fs-tiny);
  color: var(--wf-primary);
}

.breakdown-bar {
  height: 12rpx;
}

.breakdown-note {
  font-size: var(--wf-fs-tiny);
  color: var(--wf-text-sub);
  line-height: 1.7;
  background: #FCF8F7;
  border-radius: var(--wf-radius-sm);
  padding: 14rpx 20rpx;
  margin-top: 8rpx;
}

.quality-line {
  margin-top: 12rpx;
  font-size: var(--wf-fs-tiny);
  color: var(--wf-text-hint);
  line-height: 1.7;
}

.meet-link {
  display: inline-block;
  margin-top: 14rpx;
  font-size: var(--wf-fs-caption);
  color: var(--wf-primary-strong);
  font-weight: 500;
}

.compat-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx 0 16rpx;
}

.compat-empty-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--wf-primary-soft-2);
  color: var(--wf-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0.75;
  margin-bottom: 14rpx;
}

.compat-empty-text {
  font-size: var(--wf-fs-caption);
  color: var(--wf-text-sub);
}

/* ===== 6. 行动区 ===== */

.meet-card {
  padding: 32rpx;
}

.sticky-cta {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  margin-bottom: 0;
  border-radius: var(--wf-radius-xl) var(--wf-radius-xl) 0 0;
  box-shadow: 0 -8rpx 40rpx rgba(214, 116, 140, 0.14);
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.test-data-badge {
  position: absolute;
  right: 24rpx;
  top: 24rpx;
  font-size: var(--wf-fs-tiny);
  color: var(--wf-warning);
  background: var(--wf-warning-soft);
  border-radius: var(--wf-radius-pill);
  padding: 4rpx 16rpx;
}

.meet-title {
  font-size: var(--wf-fs-h2);
  font-weight: 700;
  color: var(--wf-text-main);
}

.meet-desc {
  margin-top: 8rpx;
  font-size: var(--wf-fs-tiny);
  color: var(--wf-text-sub);
  line-height: 1.6;
}

.meet-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 24rpx;
}

.meet-action-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  min-height: 84rpx;
  line-height: 1.4;
  border-radius: var(--wf-radius-pill);
  background: var(--wf-card);
  color: var(--wf-text-main);
  font-size: var(--wf-fs-caption);
  font-weight: 500;
  border: 2rpx solid var(--wf-border);
  padding: 0 32rpx;
}

.meet-action-btn::after {
  border: none;
}

.meet-action-btn-icon {
  color: var(--wf-text-sub);
}

.meet-action-primary {
  flex: 1;
  background: var(--wf-primary-grad);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  box-shadow: var(--wf-shadow-cta);
}

.meet-action-primary-icon {
  color: #ffffff;
}

.date-feedback-action {
  border-color: var(--wf-success);
  color: var(--wf-success);
  background: var(--wf-success-soft);
}

.meet-action-contact {
  border-style: dashed;
  color: var(--wf-text-sub);
}

.privacy-note {
  text-align: center;
  font-size: var(--wf-fs-tiny);
  color: var(--wf-text-hint);
  padding: 24rpx 0 8rpx;
}
