<view class="match-setting-page container">
  <block wx:if="{{pageState === 'loading'}}">
    <view class="state-wrap">
      <view class="state-icon">⏳</view>
      <view class="state-text">正在加载...</view>
    </view>
  </block>

  <block wx:elif="{{pageState === 'no-network'}}">
    <view class="state-wrap">
      <view class="state-icon">📡</view>
      <view class="state-text">网络不可用</view>
      <view class="state-btn" bindtap="onRetry">重新加载</view>
    </view>
  </block>

  <block wx:elif="{{pageState === 'error'}}">
    <view class="state-wrap">
      <view class="state-icon">⚠️</view>
      <view class="state-text">{{errorMsg}}</view>
      <view class="state-btn" bindtap="onRetry">重试</view>
    </view>
  </block>

  <block wx:else>
    <view class="page-title">择偶配置</view>
    <view class="page-subtitle">含三观文本在内的全套配置，7天仅可修改1次</view>

    <view class="cooldown-banner" wx:if="{{cooldownActive}}">
      <view class="cooldown-title">⏱ 冷却倒计时</view>
      <view class="cooldown-time">{{cooldownText}}</view>
      <view class="cooldown-hint">冷却期间不可保存，个人基础资料不受影响</view>
    </view>

    <view class="card">
      <view class="section-title">期望条件</view>

      <view class="form-item">
        <text class="form-label">期望年龄</text>
        <picker mode="selector" range="{{ageRangeOptions}}" value="{{form.preferAgeIndex}}" bindchange="onPickerChange" data-field="preferAge" disabled="{{cooldownActive}}">
          <view class="picker-value {{form.preferAge ? '' : 'placeholder'}}">{{form.preferAge || '请选择'}}</view>
        </picker>
      </view>

      <view class="form-item">
        <text class="form-label">期望身高</text>
        <picker mode="selector" range="{{heightRangeOptions}}" value="{{form.preferHeightIndex}}" bindchange="onPickerChange" data-field="preferHeight" disabled="{{cooldownActive}}">
          <view class="picker-value {{form.preferHeight ? '' : 'placeholder'}}">{{form.preferHeight || '请选择'}}</view>
        </picker>
      </view>

      <view class="form-item">
        <text class="form-label">最低学历</text>
        <picker mode="selector" range="{{educationOptions}}" value="{{form.preferEducationIndex}}" bindchange="onPickerChange" data-field="preferEducation" disabled="{{cooldownActive}}">
          <view class="picker-value {{form.preferEducation ? '' : 'placeholder'}}">{{form.preferEducation || '请选择'}}</view>
        </picker>
      </view>

      <view class="form-item">
        <text class="form-label">婚史接受度</text>
        <picker mode="selector" range="{{likeMarryOptions}}" value="{{form.likeMarryIndex}}" bindchange="onPickerChange" data-field="likeMarry" disabled="{{cooldownActive}}">
          <view class="picker-value {{form.likeMarry ? '' : 'placeholder'}}">{{form.likeMarry || '请选择'}}</view>
        </picker>
      </view>

      <view class="form-item">
        <text class="form-label">婚育节奏偏好</text>
        <picker mode="selector" range="{{likeBabyPlanOptions}}" value="{{form.likeBabyPlanIndex}}" bindchange="onPickerChange" data-field="likeBabyPlan" disabled="{{cooldownActive}}">
          <view class="picker-value {{form.likeBabyPlan ? '' : 'placeholder'}}">{{form.likeBabyPlan || '请选择'}}</view>
        </picker>
      </view>
    </view>

    <view class="card">
      <view class="section-title">外貌偏好</view>
      <view class="section-hint">这里只填写期待对方外貌；我的外貌描述在注册基础资料或“我的-外貌描述”里维护。不上传照片、不公开展示原文。</view>

      <view class="form-item">
        <text class="form-label">期待对方外貌</text>
        <textarea
          class="textarea-input"
          placeholder="例如：希望对方干净自然，运动感或文艺感都可以..."
          maxlength="{{appearanceMaxLen}}"
          value="{{appearanceWant}}"
          bindinput="onAppearanceWantInput"
          disabled="{{cooldownActive}}"
          show-confirm-bar="{{false}}"
        />
        <view class="char-counter">当前 {{appearanceWantLen}} / {{appearanceMaxLen}} 字</view>
      </view>
    </view>

    <view class="card">
      <view class="section-title">【我的三观自述】</view>
      <view class="section-hint">婚恋观、生活理念、世界观、人生观、价值观（{{textMinLen}}-{{textMaxLen}}字）</view>
      <textarea
        class="textarea-input"
        placeholder="请填写您的三观自述..."
        maxlength="{{textMaxLen}}"
        value="{{form.myValues}}"
        bindinput="onMyValuesInput"
        disabled="{{cooldownActive}}"
        show-confirm-bar="{{false}}"
      />
      <view class="char-counter {{myValuesLen < textMinLen ? 'warn' : ''}}">
        当前 {{myValuesLen}} / {{textMaxLen}} 字
      </view>
    </view>

    <view class="card">
      <view class="section-title">【期待对方三观】</view>
      <view class="section-hint">期待另一半的三观、处事理念、婚恋认知（{{textMinLen}}-{{textMaxLen}}字）</view>
      <textarea
        class="textarea-input"
        placeholder="请填写您期待对方的三观..."
        maxlength="{{textMaxLen}}"
        value="{{form.expectValues}}"
        bindinput="onExpectValuesInput"
        disabled="{{cooldownActive}}"
        show-confirm-bar="{{false}}"
      />
      <view class="char-counter {{expectValuesLen < textMinLen ? 'warn' : ''}}">
        当前 {{expectValuesLen}} / {{textMaxLen}} 字
      </view>
    </view>

    <view class="card supplement-card">
      <view class="section-title">其他补充需求（选填）</view>
      <view class="section-hint">可以写城市或未来生活规划、家庭与事业安排、生活方式、外貌气质偏好及其他具体要求。原文不会直接展示给另一方。</view>
      <textarea
        class="textarea-input"
        placeholder="例如：未来希望在华南发展，重视稳定沟通，也喜欢自然清爽的生活方式..."
        maxlength="{{otherRequirementsMaxLen}}"
        value="{{form.otherRequirements}}"
        bindinput="onOtherRequirementsInput"
        disabled="{{cooldownActive}}"
        show-confirm-bar="{{false}}"
      />
      <view class="char-counter">当前 {{otherRequirementsLen}} / {{otherRequirementsMaxLen}} 字</view>
    </view>

    <view class="card intent-confirm-card" wx:if="{{intentConfirmation}}">
      <view class="section-title">我对你的理解</view>
      <view class="section-hint">请核对下面的摘要。它只用于匹配理解，不会把推测当成你的明确要求。</view>

      <view class="intent-group" wx:if="{{intentConfirmation.must_have.length}}">
        <view class="intent-label">必要条件</view>
        <view wx:for="{{intentConfirmation.must_have}}" wx:key="value" class="intent-item">{{item.value}}</view>
      </view>
      <view class="intent-group" wx:if="{{intentConfirmation.preferences.length}}">
        <view class="intent-label">重要偏好</view>
        <view wx:for="{{intentConfirmation.preferences}}" wx:key="value" class="intent-item">{{item.value}}</view>
      </view>
      <view class="intent-group" wx:if="{{intentConfirmation.values.length}}">
        <view class="intent-label">三观与相处</view>
        <view wx:for="{{intentConfirmation.values}}" wx:key="value" class="intent-item">{{item.value}}</view>
      </view>
      <view class="intent-group" wx:if="{{intentConfirmation.lifestyle.length}}">
        <view class="intent-label">生活方式</view>
        <view wx:for="{{intentConfirmation.lifestyle}}" wx:key="value" class="intent-item">{{item.value}}</view>
      </view>
      <view class="intent-group" wx:if="{{intentConfirmation.appearance_preferences.length}}">
        <view class="intent-label">外貌与气质偏好</view>
        <view wx:for="{{intentConfirmation.appearance_preferences}}" wx:key="value" class="intent-item">{{item.value}}</view>
      </view>
      <view class="intent-group" wx:if="{{intentConfirmation.uncertainties.length}}">
        <view class="intent-label">待确认项</view>
        <view wx:for="{{intentConfirmation.uncertainties}}" wx:key="value" class="intent-item">{{item.value}}</view>
      </view>
      <view class="intent-group" wx:if="{{intentConfirmation.contradictions.length}}">
        <view class="intent-label">需要厘清的矛盾</view>
        <view wx:for="{{intentConfirmation.contradictions}}" wx:key="value" class="intent-item">{{item.value}}</view>
      </view>
      <button class="btn-primary intent-confirm-btn" bindtap="onConfirmIntent" loading="{{submitting}}" disabled="{{submitting}}">{{memberStatus === 'approved' ? '确认理解并保存' : '确认理解并提交审核'}}</button>
      <button class="btn-secondary intent-edit-btn" bindtap="onEditIntent" disabled="{{submitting}}">返回修改补充</button>
    </view>

    <view class="card ai-profile-card" wx:if="{{aiProfile}}">
      <view class="section-title">AI 对你的理解</view>
      <view class="section-hint">系统根据你的资料、三观与补充回答整理成下面这份理解。它只用于匹配，不会把推测当成你的明确要求。</view>
      <view class="ai-profile-version">版本 v{{aiProfileVersion}}{{aiConfirmed ? ' · 已确认' : ' · 待确认'}}</view>
      <view class="intent-group" wx:for="{{aiProfile.sections}}" wx:key="key" wx:for-item="section">
        <view class="intent-label">{{section.title}}</view>
        <view wx:for="{{section.items}}" wx:for-item="item" wx:key="*this" class="intent-item">{{item}}</view>
      </view>
      <view class="ai-profile-actions" wx:if="{{!aiCorrectionMode}}">
        <button class="btn-primary ai-confirm-btn" bindtap="onConfirmAiProfile" loading="{{aiFeedbackLoading}}" disabled="{{aiFeedbackLoading || aiConfirmed}}">{{aiConfirmed ? '已确认基本准确' : '基本准确'}}</button>
        <button class="btn-secondary ai-correct-btn" bindtap="onToggleAiCorrection" disabled="{{aiFeedbackLoading}}">有些地方不像我</button>
      </view>
      <view class="ai-correction-box" wx:else>
        <view class="section-hint">告诉我们哪里不像，例如“我其实没有那么事业优先”。你的纠正会作为 USER_DECLARED 证据保存，并触发 AI 理解重新生成（版本 +1）。</view>
        <textarea class="textarea-input" placeholder="简短说明哪里不像你（200字以内）" maxlength="200" value="{{aiCorrectionText}}" bindinput="onAiCorrectionInput" show-confirm-bar="{{false}}" />
        <view class="ai-correction-actions">
          <button class="btn-primary" bindtap="onSubmitAiCorrection" loading="{{aiFeedbackLoading}}" disabled="{{aiFeedbackLoading}}">提交纠正并更新</button>
          <button class="btn-secondary" bindtap="onToggleAiCorrection" disabled="{{aiFeedbackLoading}}">取消</button>
        </view>
      </view>
      <view class="ai-profile-disclaimer">AI 生成内容，仅供参考</view>
      <view class="ai-profile-footnote">置信度 {{aiProfile.overall_confidence || '--'}}；你的纠正只会用于帮助匹配，不会被摊开给另一方。</view>
    </view>

    <view class="safe-bottom">
      <button
        wx:if="{{!intentConfirmation}}"
        class="btn-primary"
        bindtap="onSubmit"
        disabled="{{cooldownActive || submitting}}"
        loading="{{submitting}}"
      >{{cooldownActive ? '冷却中，暂不可保存' : '保存配置'}}</button>
    </view>
  </block>
</view>
