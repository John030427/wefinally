<view class="match-setting-page container">
  <block wx:if="{{pageState === 'loading'}}">
    <view class="state-wrap">
      <view class="state-icon">⏳</view>
      <view class="state-text">正在加载...</view>
    </view>
  </block>

  <block wx:elif="{{pageState === 'no-network'}}">
    <view class="state-wrap">
      <view class="state-icon">📡</view>
      <view class="state-text">网络不可用</view>
      <view class="state-btn" bindtap="onRetry">重新加载</view>
    </view>
  </block>

  <block wx:elif="{{pageState === 'error'}}">
    <view class="state-wrap">
      <view class="state-icon">⚠️</view>
      <view class="state-text">{{errorMsg}}</view>
      <view class="state-btn" bindtap="onRetry">重试</view>
    </view>
  </block>

  <block wx:else>
    <view class="page-title">择偶配置</view>
    <view class="page-subtitle">含三观文本在内的全套配置，7天仅可修改1次</view>

    <view class="cooldown-banner" wx:if="{{cooldownActive}}">
      <view class="cooldown-title">⏱ 冷却倒计时</view>
      <view class="cooldown-time">{{cooldownText}}</view>
      <view class="cooldown-hint">冷却期间不可保存，个人基础资料不受影响</view>
    </view>

    <view class="card">
      <view class="section-title">期望条件</view>

      <view class="form-item">
        <text class="form-label">期望年龄</text>
        <picker mode="selector" range="{{ageRangeOptions}}" value="{{form.preferAgeIndex}}" bindchange="onPickerChange" data-field="preferAge" disabled="{{cooldownActive}}">
          <view class="picker-value {{form.preferAge ? '' : 'placeholder'}}">{{form.preferAge || '请选择'}}</view>
        </picker>
      </view>

      <view class="form-item">
        <text class="form-label">期望身高</text>
        <picker mode="selector" range="{{heightRangeOptions}}" value="{{form.preferHeightIndex}}" bindchange="onPickerChange" data-field="preferHeight" disabled="{{cooldownActive}}">
          <view class="picker-value {{form.preferHeight ? '' : 'placeholder'}}">{{form.preferHeight || '请选择'}}</view>
        </picker>
      </view>

      <view class="form-item">
        <text class="form-label">最低学历</text>
        <picker mode="selector" range="{{educationOptions}}" value="{{form.preferEducationIndex}}" bindchange="onPickerChange" data-field="preferEducation" disabled="{{cooldownActive}}">
          <view class="picker-value {{form.preferEducation ? '' : 'placeholder'}}">{{form.preferEducation || '请选择'}}</view>
        </picker>
      </view>

      <view class="form-item">
        <text class="form-label">婚史接受度</text>
        <picker mode="selector" range="{{likeMarryOptions}}" value="{{form.likeMarryIndex}}" bindchange="onPickerChange" data-field="likeMarry" disabled="{{cooldownActive}}">
          <view class="picker-value {{form.likeMarry ? '' : 'placeholder'}}">{{form.likeMarry || '请选择'}}</view>
        </picker>
      </view>

      <view class="form-item">
        <text class="form-label">婚育节奏偏好</text>
        <picker mode="selector" range="{{likeBabyPlanOptions}}" value="{{form.likeBabyPlanIndex}}" bindchange="onPickerChange" data-field="likeBabyPlan" disabled="{{cooldownActive}}">
          <view class="picker-value {{form.likeBabyPlan ? '' : 'placeholder'}}">{{form.likeBabyPlan || '请选择'}}</view>
        </picker>
      </view>
    </view>

    <view class="card">
      <view class="section-title">外貌偏好</view>
      <view class="section-hint">这里只填写期待对方外貌；我的外貌描述在注册基础资料或“我的-外貌描述”里维护。不上传照片、不公开展示原文。</view>

      <view class="form-item">
        <text class="form-label">期待对方外貌</text>
        <textarea
          class="textarea-input"
          placeholder="例如：希望对方干净自然，运动感或文艺感都可以..."
          maxlength="{{appearanceMaxLen}}"
          value="{{appearanceWant}}"
          bindinput="onAppearanceWantInput"
          disabled="{{cooldownActive}}"
          show-confirm-bar="{{false}}"
        />
        <view class="char-counter">当前 {{appearanceWantLen}} / {{appearanceMaxLen}} 字</view>
      </view>
    </view>

    <view class="card">
      <view class="section-title">【我的三观自述】</view>
      <view class="section-hint">婚恋观、生活理念、世界观、人生观、价值观（{{textMinLen}}-{{textMaxLen}}字）</view>
      <textarea
        class="textarea-input"
        placeholder="请填写您的三观自述..."
        maxlength="{{textMaxLen}}"
        value="{{form.myValues}}"
        bindinput="onMyValuesInput"
        disabled="{{cooldownActive}}"
        show-confirm-bar="{{false}}"
      />
      <view class="char-counter {{myValuesLen < textMinLen ? 'warn' : ''}}">
        当前 {{myValuesLen}} / {{textMaxLen}} 字
      </view>
    </view>

    <view class="card">
      <view class="section-title">【期待对方三观】</view>
      <view class="section-hint">期待另一半的三观、处事理念、婚恋认知（{{textMinLen}}-{{textMaxLen}}字）</view>
      <textarea
        class="textarea-input"
        placeholder="请填写您期待对方的三观..."
        maxlength="{{textMaxLen}}"
        value="{{form.expectValues}}"
        bindinput="onExpectValuesInput"
        disabled="{{cooldownActive}}"
        show-confirm-bar="{{false}}"
      />
      <view class="char-counter {{expectValuesLen < textMinLen ? 'warn' : ''}}">
        当前 {{expectValuesLen}} / {{textMaxLen}} 字
      </view>
    </view>

    <view class="safe-bottom">
      <button
        class="btn-primary"
        bindtap="onSubmit"
        disabled="{{cooldownActive || submitting}}"
        loading="{{submitting}}"
      >{{cooldownActive ? '冷却中，暂不可保存' : '保存配置'}}</button>
    </view>
  </block>
</view>
