.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.section-hint {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 16rpx;
  line-height: 1.5;
}

.cooldown-title {
  font-size: 26rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.cooldown-time {
  font-size: 32rpx;
  font-weight: 700;
  font-family: monospace;
  margin-bottom: 8rpx;
}

.cooldown-hint {
  font-size: 22rpx;
  opacity: 0.85;
}

.supplement-card {
  border-left: 6rpx solid #c96b45;
}

.intent-confirm-card {
  border-left: 6rpx solid #8a7564;
  margin-bottom: 24rpx;
}

.intent-group {
  padding: 14rpx 0 4rpx 18rpx;
  border-left: 2rpx solid #e8ded5;
}

.intent-label {
  color: #8a7564;
  font-size: 24rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.intent-item {
  color: #2f2a26;
  font-size: 25rpx;
  line-height: 1.6;
  margin-bottom: 6rpx;
}

.intent-confirm-btn {
  margin-top: 24rpx;
}
.ai-profile-card {
  border-left: 6rpx solid #74a6a0;
  margin-bottom: 24rpx;
}

.ai-profile-version {
  font-size: 22rpx;
  color: #74a6a0;
  margin-bottom: 12rpx;
}

.ai-profile-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.ai-confirm-btn {
  flex: 1;
}

.ai-correct-btn {
  flex: 1;
}

.ai-correction-box {
  margin-top: 16rpx;
}

.ai-correction-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.ai-profile-disclaimer {
  margin-top: 18rpx;
  font-size: 24rpx;
  color: #8a7564;
  text-align: center;
}

.ai-profile-footnote {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #999;
  line-height: 1.5;
}
