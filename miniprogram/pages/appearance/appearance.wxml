<view class="appearance-page container">
  <block wx:if="{{pageState === 'loading'}}">
    <view class="state-wrap">
      <view class="state-icon">⏳</view>
      <view class="state-text">正在加载...</view>
    </view>
  </block>

  <block wx:elif="{{pageState === 'no-network'}}">
    <view class="state-wrap">
      <view class="state-icon">📡</view>
      <view class="state-text">网络不可用</view>
      <view class="state-btn" bindtap="onRetry">重新加载</view>
    </view>
  </block>

  <block wx:elif="{{pageState === 'error'}}">
    <view class="state-wrap">
      <view class="state-icon">⚠️</view>
      <view class="state-text">{{errorMsg}}</view>
      <view class="state-btn" bindtap="onRetry">重试</view>
    </view>
  </block>

  <block wx:else>
    <view class="page-title">外貌描述</view>
    <view class="page-subtitle">选填，不上传照片；默认仅本人和后台可见</view>

    <view class="card">
      <view class="section-title">我的外貌描述</view>
      <view class="section-hint">可描述身高感、体型、穿搭、发型、气质等</view>
      <textarea
        class="textarea-input"
        placeholder="例如：中等偏高，日常穿搭简洁，气质清爽..."
        maxlength="{{maxLen}}"
        value="{{appearanceDescription}}"
        bindinput="onDescInput"
        show-confirm-bar="{{false}}"
      />
      <view class="char-counter">当前 {{descLen}} / {{maxLen}} 字</view>
    </view>

    <view class="card">
      <view class="section-title">期待对方外貌</view>
      <view class="section-hint">可写你偏好的整体感觉，不做颜值打分</view>
      <textarea
        class="textarea-input"
        placeholder="例如：希望对方干净自然，运动感或文艺感都可以..."
        maxlength="{{maxLen}}"
        value="{{appearanceWant}}"
        bindinput="onWantInput"
        show-confirm-bar="{{false}}"
      />
      <view class="char-counter">当前 {{wantLen}} / {{maxLen}} 字</view>
    </view>

    <view class="safe-bottom">
      <button class="btn-primary" bindtap="onSubmit" loading="{{submitting}}" disabled="{{submitting}}">保存</button>
    </view>
  </block>
</view>
