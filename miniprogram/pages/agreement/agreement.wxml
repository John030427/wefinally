<view class="agreement-page container">
  <block wx:if="{{pageState === 'loading'}}">
    <view class="state-wrap">
      <view class="state-icon">⏳</view>
      <view class="state-text">正在加载...</view>
    </view>
  </block>

  <block wx:elif="{{pageState === 'no-network'}}">
    <view class="state-wrap">
      <view class="state-icon">📡</view>
      <view class="state-text">网络不可用</view>
      <view class="state-btn" bindtap="onRetry">重新加载</view>
    </view>
  </block>

  <block wx:elif="{{pageState === 'error'}}">
    <view class="state-wrap">
      <view class="state-icon">⚠️</view>
      <view class="state-text">{{errorMsg}}</view>
      <view class="state-btn" bindtap="onRetry">重试</view>
    </view>
  </block>

  <block wx:else>
    <view class="page-title">请阅读并同意以下协议</view>
    <view class="page-subtitle">三项协议均需勾选后方可继续</view>

    <view class="card agreement-list">
      <view
        class="agreement-item"
        wx:for="{{agreementItems}}"
        wx:key="key"
      >
        <view class="checkbox-wrap" bindtap="onCheckChange" data-key="{{item.key}}">
          <view class="checkbox {{checked[item.key] ? 'checked' : ''}}">
            <text wx:if="{{checked[item.key]}}">✓</text>
          </view>
          <text class="agreement-label">{{item.label}}</text>
        </view>
        <text class="view-link" bindtap="viewAgreement" data-type="{{item.key}}">查看</text>
      </view>
    </view>

    <view class="safe-bottom">
      <button
        class="btn-primary"
        bindtap="onSubmit"
        disabled="{{!allChecked || submitting}}"
        loading="{{submitting}}"
      >同意并继续</button>
    </view>
  </block>
</view>
