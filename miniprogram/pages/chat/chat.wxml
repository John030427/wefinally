<view class="chat-page">
  <block wx:if="{{pageState === 'loading'}}">
    <view class="state-wrap">
      <view class="state-icon">⏳</view>
      <view class="state-text">正在加载...</view>
    </view>
  </block>

  <block wx:elif="{{pageState === 'no-network'}}">
    <view class="state-wrap">
      <view class="state-icon">📡</view>
      <view class="state-text">网络不可用</view>
      <view class="state-btn" bindtap="onRetry">重新加载</view>
    </view>
  </block>

  <block wx:else>
    <view class="user-id-bar">
      <view class="user-id-copy-row">
        <view class="user-id-label">用户ID</view>
        <view wx:if="{{supportCodeState === 'ready'}}" class="user-id-code">{{supportCode}}</view>
        <view wx:elif="{{supportCodeState === 'loading'}}" class="user-id-state">加载中...</view>
        <view wx:else class="user-id-state user-id-error">{{supportCodeError || '加载失败'}}</view>
        <button wx:if="{{supportCodeState === 'ready'}}" class="user-id-copy" bindtap="copySupportCode">复制</button>
        <button wx:elif="{{supportCodeState === 'error'}}" class="user-id-copy" bindtap="retrySupportCode">重试</button>
      </view>
      <view class="user-id-help">咨询账号问题时，可向客服提供此编号快速查询</view>
    </view>
    <scroll-view class="chat-scroll" scroll-y scroll-into-view="{{scrollToView}}" scroll-with-animation>
      <view class="chat-tip">{{agentType === 'love_advisor' ? '温和陪伴，信息有限时会明确说明知识不足' : (agentType === 'date_coordinator' ? '只说明共同进度，不展示对方原始回答' : '优先处理平台业务咨询')}}</view>
      <view class="ai-disclaimer">🤖 AI 生成回复仅供参考，重要事项请以官方客服确认为准</view>
      <view
        id="msg-{{item.id}}"
        class="msg-row {{item.isBot ? 'msg-bot' : 'msg-user'}}"
        wx:for="{{messages}}"
        wx:key="id"
      >
        <view wx:if="{{item.isBot && item.status === 'generating'}}" class="msg-bubble msg-bubble-generating">
          <text class="msg-text">{{item.waitingText || '✨ AI 正在理解你的调整…'}}</text>
          <text class="msg-time">AI生成中</text>
        </view>
        <view wx:elif="{{item.isBot && item.status === 'error'}}" class="msg-bubble msg-bubble-error">
          <text class="msg-text">{{item.errorText || '回复生成失败'}}</text>
          <button class="retry-btn" data-message-id="{{item.id}}" bindtap="retryAiMessage" disabled="{{sending}}">重新生成</button>
          <text class="msg-time">{{item.timeText}}</text>
        </view>
        <block wx:else>
          <view class="msg-bubble">
            <text class="msg-text">{{item.content}}</text>
            <text class="msg-time">{{item.timeText}}</text>
          </view>
          <view wx:if="{{item.eventCard}}" class="event-card">
            <view class="event-card-title">协调进展 · V{{item.eventCard.coordinationVersion}}</view>
            <view wx:if="{{item.eventCard.changedDimensionsText}}" class="event-card-change">本次变化：{{item.eventCard.changedDimensionsText}}</view>
            <view wx:if="{{item.eventCard.summary}}" class="event-card-summary">{{item.eventCard.summary}}</view>
          </view>
          <view wx:if="{{item.patchPreview}}" class="patch-preview-card">
            <view class="patch-preview-title">{{item.patchPreview.title}}</view>
            <view class="patch-change" wx:for="{{item.patchPreview.changes}}" wx:for-item="change" wx:key="field">
              <view class="patch-field">{{change.label}}</view>
              <view wx:if="{{item.patchPreview.operation === 'create'}}" class="patch-value-row"><text class="patch-value-label">待发送</text><text class="patch-value after">{{change.after}}</text></view>
              <block wx:else>
                <view class="patch-value-row"><text class="patch-value-label">修改前</text><text class="patch-value before">{{change.before}}</text></view>
                <view class="patch-value-row"><text class="patch-value-label">修改后</text><text class="patch-value after">{{change.after}}</text></view>
              </block>
            </view>
            <view wx:if="{{item.patchPreview.status === 'superseded'}}" class="patch-status patch-status-muted">已被新的调整替代</view>
            <block wx:else>
              <view wx:if="{{item.patchPreview.operation === 'create'}}" class="patch-notice">📌 这是待发送申请，当前尚未通知对方。</view>
              <view wx:elif="{{item.patchPreview.affectsExistingProposal}}" class="patch-notice">📌 影响现有方案，确认后会重新为你们匹配。</view>
              <view wx:else class="patch-notice">📌 不影响现有方案，会保留当前匹配进度。</view>
              <view wx:if="{{item.patchPreview.willNotifyPartner}}" class="patch-notice">💌 确认后将通知对方。</view>
              <view wx:else class="patch-notice">💌 这次修改不会主动通知对方。</view>
              <view wx:if="{{item.patchPreview.primaryResolutionRequired && item.patchPreview.status === 'pending_primary_selection'}}" class="primary-resolution">
                <view class="patch-notice">{{item.patchPreview.resolutionPrompt}}</view>
                <view wx:for="{{item.patchPreview.primaryResolutionFields}}" wx:for-item="resField" wx:key="field">
                  <view class="patch-field">本次建议{{resField.label}}需要确认</view>
                  <view class="primary-choice-row">
                    <view
                      class="primary-choice"
                      wx:for="{{resField.options}}"
                      wx:for-item="opt"
                      wx:key="key"
                      data-message-id="{{item.id}}"
                      data-field="{{resField.field}}"
                      data-value="{{opt.value}}"
                      data-date="{{opt.date}}"
                      data-period="{{opt.period}}"
                      bindtap="onSelectPrimaryResolution"
                    >{{opt.label}}</view>
                  </view>
                </view>
              </view>
              <view wx:if="{{item.patchPreview.requiresConfirmation && item.patchPreview.status === 'pending_confirmation'}}" class="patch-actions">
                <button class="patch-confirm" data-patch-id="{{item.patchPreview.id}}" data-message-id="{{item.id}}" bindtap="onConfirmPatch" disabled="{{patchSubmitting}}" loading="{{patchSubmitting}}">{{item.patchPreview.confirmLabel}}</button>
                <button class="patch-cancel" data-patch-id="{{item.patchPreview.id}}" data-message-id="{{item.id}}" bindtap="onCancelPatch" disabled="{{patchSubmitting}}">{{item.patchPreview.cancelLabel}}</button>
              </view>
              <view wx:if="{{item.patchPreview.primaryResolutionRequired && item.patchPreview.status === 'pending_primary_selection'}}" class="patch-actions">
                <button class="patch-cancel" data-patch-id="{{item.patchPreview.id}}" data-message-id="{{item.id}}" bindtap="onCancelPatch" disabled="{{patchSubmitting}}">暂不修改</button>
              </view>
              <view wx:elif="{{item.patchPreview.status === 'applied'}}" class="patch-status">{{item.patchPreview.operation === 'create' ? '已确认发送' : '已确认修改'}}</view>
              <view wx:elif="{{item.patchPreview.status === 'cancelled'}}" class="patch-status">{{item.patchPreview.operation === 'create' ? '已暂不发送' : '已暂不修改'}}</view>
            </block>
          </view>
          <button wx:if="{{item.handoff && item.handoff.provider === 'wechat_kf'}}" class="human-service-btn" open-type="contact">联系微信客服</button>
          <button wx:if="{{item.handoff && item.handoff.provider === 'wecom'}}" class="human-service-btn" data-message-id="{{item.id}}" bindtap="openHumanService">打开企业微信客服</button>
        </block>
      </view>
    </scroll-view>

    <view class="chat-input-bar safe-bottom">
      <input
        class="chat-input"
        placeholder="{{coordinatorReadOnly ? '当前结果仅供查看' : (agentType === 'date_coordinator' ? '例如：下周三晚上8点吃寿司郎可以吗' : '输入您的问题...')}}"
        value="{{inputText}}"
        bindinput="onInput"
        confirm-type="send"
        bindconfirm="onSend"
        disabled="{{sending || coordinatorReadOnly}}"
      />
      <button class="send-btn" bindtap="onSend" disabled="{{sending || coordinatorReadOnly || !inputText}}" loading="{{sending}}">发送</button>
    </view>
  </block>
</view>
