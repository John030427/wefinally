<view class="chat-page">
  <block wx:if="{{pageState === 'loading'}}">
    <view class="state-wrap">
      <view class="state-icon">⏳</view>
      <view class="state-text">正在加载...</view>
    </view>
  </block>

  <block wx:elif="{{pageState === 'no-network'}}">
    <view class="state-wrap">
      <view class="state-icon">📡</view>
      <view class="state-text">网络不可用</view>
      <view class="state-btn" bindtap="onRetry">重新加载</view>
    </view>
  </block>

  <block wx:else>
    <scroll-view class="chat-scroll" scroll-y scroll-into-view="{{scrollToView}}" scroll-with-animation>
      <view class="chat-tip">{{agentType === 'love_advisor' ? '温和陪伴，信息有限时会明确说明知识不足' : (agentType === 'date_coordinator' ? '只说明共同进度，不展示对方原始回答' : '优先处理平台业务咨询')}}</view>
      <view
        id="msg-{{item.id}}"
        class="msg-row {{item.isBot ? 'msg-bot' : 'msg-user'}}"
        wx:for="{{messages}}"
        wx:key="id"
      >
        <view class="msg-bubble">
          <text class="msg-text">{{item.content}}</text>
          <text class="msg-time">{{item.timeText}}</text>
        </view>
      </view>
    </scroll-view>

    <view class="chat-input-bar safe-bottom">
      <input
        class="chat-input"
        placeholder="输入您的问题..."
        value="{{inputText}}"
        bindinput="onInput"
        confirm-type="send"
        bindconfirm="onSend"
        disabled="{{sending}}"
      />
      <button class="send-btn" bindtap="onSend" disabled="{{sending || !inputText}}" loading="{{sending}}">发送</button>
    </view>
  </block>
</view>
