<view class="chat-page">
  <block wx:if="{{pageState === 'loading'}}">
    <view class="state-wrap">
      <view class="state-icon">⏳</view>
      <view class="state-text">正在加载...</view>
    </view>
  </block>

  <block wx:elif="{{pageState === 'no-network'}}">
    <view class="state-wrap">
      <view class="state-icon">📡</view>
      <view class="state-text">网络不可用</view>
      <view class="state-btn" bindtap="onRetry">重新加载</view>
    </view>
  </block>

  <block wx:else>
    <scroll-view class="chat-scroll" scroll-y scroll-into-view="{{scrollToView}}" scroll-with-animation>
      <view class="chat-tip">{{agentType === 'love_advisor' ? '温和陪伴，信息有限时会明确说明知识不足' : (agentType === 'date_coordinator' ? '只说明共同进度，不展示对方原始回答' : '优先处理平台业务咨询')}}</view>
      <view
        id="msg-{{item.id}}"
        class="msg-row {{item.isBot ? 'msg-bot' : 'msg-user'}}"
        wx:for="{{messages}}"
        wx:key="id"
      >
        <view class="msg-bubble">
          <text class="msg-text">{{item.content}}</text>
          <text class="msg-time">{{item.timeText}}</text>
        </view>
        <view wx:if="{{item.patchPreview}}" class="patch-preview-card">
          <view class="patch-preview-title">{{item.patchPreview.operation === 'create' ? '💌 约会申请发送预览' : '💗 约会条件修改预览'}}</view>
          <view class="patch-change" wx:for="{{item.patchPreview.changes}}" wx:key="field">
            <view class="patch-field">{{item.label}}</view>
            <view wx:if="{{item.patchPreview.operation === 'create'}}" class="patch-value-row"><text class="patch-value-label">待发送</text><text class="patch-value after">{{item.after}}</text></view>
            <block wx:else>
              <view class="patch-value-row"><text class="patch-value-label">修改前</text><text class="patch-value before">{{item.before}}</text></view>
              <view class="patch-value-row"><text class="patch-value-label">修改后</text><text class="patch-value after">{{item.after}}</text></view>
            </block>
          </view>
          <view wx:if="{{item.patchPreview.operation === 'create'}}" class="patch-notice">📌 这是待发送申请，当前尚未通知对方。</view>
          <view wx:elif="{{item.patchPreview.affectsExistingProposal}}" class="patch-notice">📌 影响现有方案，确认后会重新为你们匹配。</view>
          <view wx:else class="patch-notice">📌 不影响现有方案，会保留当前匹配进度。</view>
          <view wx:if="{{item.patchPreview.willNotifyPartner}}" class="patch-notice">💌 确认后将通知对方。</view>
          <view wx:else class="patch-notice">💌 这次修改不会主动通知对方。</view>
          <view wx:if="{{item.patchPreview.requiresConfirmation && item.patchPreview.status === 'pending_confirmation'}}" class="patch-actions">
            <button class="patch-confirm" data-patch-id="{{item.patchPreview.id}}" data-message-id="{{item.id}}" bindtap="onConfirmPatch" disabled="{{patchSubmitting}}" loading="{{patchSubmitting}}">{{item.patchPreview.operation === 'create' ? '确认发送' : '确认修改'}}</button>
            <button class="patch-cancel" data-patch-id="{{item.patchPreview.id}}" data-message-id="{{item.id}}" bindtap="onCancelPatch" disabled="{{patchSubmitting}}">{{item.patchPreview.operation === 'create' ? '暂不发送' : '暂不修改'}}</button>
          </view>
          <view wx:elif="{{item.patchPreview.status === 'applied'}}" class="patch-status">{{item.patchPreview.operation === 'create' ? '已确认发送' : '已确认修改'}}</view>
          <view wx:elif="{{item.patchPreview.status === 'cancelled'}}" class="patch-status">{{item.patchPreview.operation === 'create' ? '已暂不发送' : '已暂不修改'}}</view>
        </view>
        <button wx:if="{{item.handoff && item.handoff.provider === 'wechat_kf'}}" class="human-service-btn" open-type="contact">联系微信客服</button>
        <button wx:if="{{item.handoff && item.handoff.provider === 'wecom'}}" class="human-service-btn" data-message-id="{{item.id}}" bindtap="openHumanService">打开企业微信客服</button>
      </view>
    </scroll-view>

    <view class="chat-input-bar safe-bottom">
      <input
        class="chat-input"
        placeholder="输入您的问题..."
        value="{{inputText}}"
        bindinput="onInput"
        confirm-type="send"
        bindconfirm="onSend"
        disabled="{{sending}}"
      />
      <button class="send-btn" bindtap="onSend" disabled="{{sending || !inputText}}" loading="{{sending}}">发送</button>
    </view>
  </block>
</view>
