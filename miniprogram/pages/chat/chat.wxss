/* AI 对话页 — 陪伴感 + 专业感；生成中/失败/重试统一态 */
.chat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--wf-bg);
}

/* ===== 用户ID工具行 ===== */

.user-id-bar {
  flex: 0 0 auto;
  margin: 20rpx 28rpx 0;
  padding: 18rpx 24rpx;
  border: 1rpx solid var(--wf-border);
  border-radius: var(--wf-radius-md);
  background: var(--wf-card);
}

.user-id-copy-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 52rpx;
}

.user-id-label {
  color: var(--wf-text-hint);
  font-size: var(--wf-fs-tiny);
  letter-spacing: 1rpx;
}

.user-id-code {
  flex: 1;
  color: var(--wf-text-main);
  font-size: var(--wf-fs-caption);
  font-weight: 600;
  letter-spacing: 1rpx;
}

.user-id-state {
  flex: 1;
  color: var(--wf-text-hint);
  font-size: var(--wf-fs-caption);
}

.user-id-error {
  color: var(--wf-danger);
}

.user-id-copy {
  flex-shrink: 0;
  font-size: var(--wf-fs-tiny);
  color: var(--wf-primary-strong);
  background: var(--wf-primary-soft-2);
  border-radius: var(--wf-radius-pill);
  padding: 8rpx 24rpx;
  line-height: 1.5;
}

.user-id-copy-pressed {
  opacity: 0.7;
}

.user-id-help {
  margin-top: 8rpx;
  color: var(--wf-text-hint);
  font-size: var(--wf-fs-tiny);
  line-height: 1.5;
}

/* ===== 消息区 ===== */

.chat-scroll {
  flex: 1;
  min-height: 0;
  padding: 0 28rpx;
  box-sizing: border-box;
}

.chat-tip {
  margin: 20rpx auto 12rpx;
  text-align: center;
  font-size: var(--wf-fs-tiny);
  color: var(--wf-text-hint);
}

.chat-disclaimer-line {
  display: flex;
  justify-content: center;
  margin-bottom: 24rpx;
}

.chat-scroll-pad {
  height: 32rpx;
}

.msg-row {
  display: flex;
  flex-direction: column;
  margin-bottom: 28rpx;
}

.msg-bot {
  align-items: flex-start;
}

.msg-user {
  align-items: flex-end;
}

.msg-bubble {
  max-width: 82%;
  padding: 22rpx 26rpx;
  border-radius: var(--wf-radius-lg);
  background: var(--wf-card);
  box-shadow: var(--wf-shadow-card);
}

.msg-bot .msg-bubble {
  border-bottom-left-radius: 8rpx;
}

.msg-user .msg-bubble {
  background: var(--wf-primary-grad);
  border-bottom-right-radius: 8rpx;
  box-shadow: 0 6rpx 18rpx rgba(232, 99, 127, 0.24);
}

.msg-bubble-reveal {
  animation: wf-msg-in 0.3s ease-out;
}

.msg-text {
  font-size: var(--wf-fs-body);
  line-height: 1.7;
  color: var(--wf-text-main);
  word-break: break-all;
}

.msg-user .msg-text {
  color: #ffffff;
}

.msg-time {
  display: block;
  margin-top: 10rpx;
  font-size: var(--wf-fs-tiny);
  color: var(--wf-text-hint);
  text-align: right;
}

.msg-user .msg-time {
  color: rgba(255, 255, 255, 0.75);
}

.msg-time-inset {
  margin-top: 4rpx;
}

/* 生成中气泡 */
.msg-bubble-generating {
  background: var(--wf-ai-soft);
  border: 1rpx solid rgba(123, 108, 200, 0.18);
  min-width: 320rpx;
}

.msg-bubble-generating .ai-thinking {
  padding: 8rpx 0 4rpx;
}

/* 错误气泡 */
.msg-bubble-error {
  background: var(--wf-danger-soft);
  border: 1rpx solid rgba(217, 83, 79, 0.18);
}

.error-text {
  color: var(--wf-danger);
}

.retry-btn {
  margin-top: 16rpx;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: var(--wf-radius-pill);
  background: var(--wf-card);
  color: var(--wf-danger);
  font-size: var(--wf-fs-caption);
  font-weight: 600;
  border: 2rpx solid rgba(217, 83, 79, 0.35);
  padding: 0 32rpx;
}

.retry-btn::after {
  border: none;
}

/* ===== 约会申请/修改预览卡 ===== */

.patch-preview-card {
  width: 88%;
  margin-top: 14rpx;
  background: var(--wf-card);
  border: 1rpx solid var(--wf-border);
  border-radius: var(--wf-radius-md);
  padding: 24rpx 26rpx;
  box-shadow: var(--wf-shadow-card);
}

.patch-preview-title {
  font-size: var(--wf-fs-body);
  font-weight: 700;
  color: var(--wf-text-main);
  margin-bottom: 14rpx;
}

.patch-change {
  padding: 12rpx 0;
  border-bottom: 1rpx solid var(--wf-border);
}

.patch-field {
  font-size: var(--wf-fs-tiny);
  color: var(--wf-text-hint);
  margin-bottom: 4rpx;
}

.patch-value-row {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.patch-value-label {
  flex-shrink: 0;
  font-size: var(--wf-fs-tiny);
  color: var(--wf-text-hint);
}

.patch-value {
  font-size: var(--wf-fs-caption);
  color: var(--wf-text-main);
}

.patch-value.before {
  color: var(--wf-text-hint);
  text-decoration: line-through;
}

.patch-value.after {
  font-weight: 600;
  color: var(--wf-primary-strong);
}

.patch-notice {
  margin-top: 10rpx;
  font-size: var(--wf-fs-tiny);
  color: var(--wf-text-sub);
  line-height: 1.6;
}

.primary-resolution {
  margin-top: 14rpx;
  background: var(--wf-primary-soft-2);
  border-radius: var(--wf-radius-sm);
  padding: 16rpx 20rpx;
}

.primary-choice-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 10rpx;
}

.primary-choice {
  padding: 12rpx 26rpx;
  border-radius: var(--wf-radius-pill);
  border: 2rpx solid var(--wf-primary);
  background: var(--wf-card);
  color: var(--wf-primary-strong);
  font-size: var(--wf-fs-caption);
  font-weight: 500;
}

.patch-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 18rpx;
}

.patch-confirm {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: var(--wf-radius-pill);
  background: var(--wf-primary-grad);
  color: #ffffff;
  font-size: var(--wf-fs-caption);
  font-weight: 600;
  border: none;
  box-shadow: var(--wf-shadow-cta);
  padding: 0;
}

.patch-confirm::after {
  border: none;
}

.patch-cancel {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: var(--wf-radius-pill);
  background: var(--wf-card);
  color: var(--wf-text-sub);
  font-size: var(--wf-fs-caption);
  border: 2rpx solid var(--wf-border);
  padding: 0;
}

.patch-cancel::after {
  border: none;
}

.patch-status {
  margin-top: 16rpx;
  text-align: center;
  font-size: var(--wf-fs-tiny);
  color: var(--wf-success);
  font-weight: 600;
}

/* ===== 转人工 ===== */

.human-service-btn {
  margin-top: 14rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: var(--wf-radius-pill);
  background: var(--wf-card);
  color: var(--wf-primary-strong);
  font-size: var(--wf-fs-caption);
  font-weight: 600;
  border: 2rpx solid var(--wf-primary-soft);
  padding: 0 36rpx;
}

.human-service-btn::after {
  border: none;
}

/* ===== 输入区 ===== */

.chat-input-bar {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 28rpx;
  background: var(--wf-card);
  border-top: 1rpx solid var(--wf-border);
}

.chat-input {
  flex: 1;
  height: 76rpx;
  background: var(--wf-primary-soft-2);
  border-radius: var(--wf-radius-pill);
  padding: 0 32rpx;
  font-size: var(--wf-fs-body);
}

.send-btn {
  flex-shrink: 0;
  height: 76rpx;
  line-height: 76rpx;
  padding: 0 36rpx;
  border-radius: var(--wf-radius-pill);
  background: var(--wf-primary-grad);
  color: #ffffff;
  font-size: var(--wf-fs-caption);
  font-weight: 600;
  border: none;
  box-shadow: var(--wf-shadow-cta);
}

.send-btn[disabled] {
  background: #E5DBDB;
  color: #ffffff;
  box-shadow: none;
}

.send-btn::after {
  border: none;
}

@keyframes wf-msg-in {
  from { opacity: 0; transform: translateY(10rpx); }
  to { opacity: 1; transform: translateY(0); }
}
