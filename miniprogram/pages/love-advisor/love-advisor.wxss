/* AI 恋爱助手入口 — 陪伴感 + 专业感 */
.love-page {
  padding-bottom: calc(64rpx + env(safe-area-inset-bottom));
}

.row-card-pressed {
  opacity: 0.85;
  transform: scale(0.99);
}

.love-hero {
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  box-sizing: border-box;
  padding: 56rpx 40rpx 44rpx;
  background: linear-gradient(160deg, #F9DEE4, #FDF1F3 55%, #FFFFFF);
  border: 1rpx solid rgba(240, 228, 228, 0.8);
  border-radius: var(--wf-radius-xl);
  margin-bottom: 12rpx;
  box-shadow: var(--wf-shadow-card);
}

.love-halo {
  position: absolute;
  right: -110rpx;
  top: -110rpx;
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
  border: 26rpx solid rgba(232, 99, 127, 0.08);
  pointer-events: none;
}

.love-orb {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: var(--wf-primary-grad);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 16rpx 36rpx rgba(232, 99, 127, 0.3);
  margin-bottom: 28rpx;
}

.love-orb-icon {
  color: #ffffff;
}

.love-title {
  font-size: var(--wf-fs-h1);
  font-weight: 700;
  color: var(--wf-text-main);
  margin-bottom: 16rpx;
}

.love-copy {
  margin-bottom: 20rpx;
}

.love-subtitle {
  font-size: var(--wf-fs-caption);
  color: var(--wf-text-sub);
  line-height: 1.8;
}

.ai-dislosure-line {
  margin-bottom: 8rpx;
}

.love-start {
  margin-top: 20rpx;
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: var(--wf-radius-pill);
  background: var(--wf-primary-grad);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  box-shadow: var(--wf-shadow-cta);
}

.love-start::after {
  border: none;
}

.section-header-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--wf-text-main);
}

.topic-card {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 26rpx 30rpx;
}

.topic-index {
  width: 56rpx;
  height: 56rpx;
  border-radius: var(--wf-radius-sm);
  background: var(--wf-primary-soft);
  color: var(--wf-primary-strong);
  font-size: var(--wf-fs-caption);
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.topic-copy {
  flex: 1;
  min-width: 0;
}

.topic-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--wf-text-main);
}

.topic-desc {
  margin-top: 4rpx;
  font-size: var(--wf-fs-caption);
  color: var(--wf-text-sub);
  line-height: 1.6;
}

.knowledge-note {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 28rpx;
  padding: 0 12rpx;
  font-size: var(--wf-fs-tiny);
  color: var(--wf-text-hint);
  line-height: 1.7;
}

.knowledge-note-icon {
  color: var(--wf-success);
  margin-top: 4rpx;
}
