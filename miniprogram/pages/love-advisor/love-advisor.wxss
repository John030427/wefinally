.love-page {
  padding-bottom: 64rpx;
}

.love-hero {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  box-sizing: border-box;
  padding: 48rpx 36rpx 40rpx;
  background: #ff6b8a;
  border-radius: 24rpx;
  color: #fff;
  margin-bottom: 36rpx;
}

.love-title {
  font-size: 38rpx;
  font-weight: 600;
  margin-bottom: 14rpx;
  line-height: 1.4;
}

.love-copy {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.love-subtitle {
  font-size: 26rpx;
  line-height: 1.7;
  opacity: .95;
}

.love-ai-disclosure {
  margin-top: 28rpx;
  padding: 18rpx 22rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.22);
  border: 2rpx solid rgba(255, 255, 255, 0.42);
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.55;
  text-align: center;
}

.love-start {
  display: flex;
  align-items: center;
  justify-content: center;
  align-self: stretch;
  width: auto;
  box-sizing: border-box;
  margin: 28rpx 0 0;
  padding: 0;
  height: 80rpx;
  min-height: 80rpx;
  line-height: 80rpx;
  border: none;
  border-radius: 40rpx;
  background: #fff;
  color: #ff6b8a;
  font-size: 28rpx;
  font-family: inherit;
  font-weight: 500;
}

.love-start::after {
  border: none;
}

.topic-card {
  margin-bottom: 18rpx;
}

.topic-title {
  font-size: 30rpx;
  color: #333;
  font-weight: 600;
  margin-bottom: 10rpx;
}

.topic-desc,
.knowledge-note {
  font-size: 25rpx;
  color: #777;
  line-height: 1.7;
}

.knowledge-note {
  padding: 22rpx 26rpx;
  background: #fff4f6;
  border-radius: 16rpx;
  color: #9a5665;
}
