<view class="notifications-page container">
  <block wx:if="{{pageState === 'loading'}}">
    <view class="state-wrap"><view class="state-text">正在加载消息...</view></view>
  </block>
  <block wx:elif="{{pageState === 'no-network'}}">
    <view class="state-wrap"><view class="state-text">网络不可用</view><view class="state-btn" bindtap="load">重试</view></view>
  </block>
  <block wx:elif="{{pageState === 'error'}}">
    <view class="state-wrap"><view class="state-text">{{errorMsg}}</view><view class="state-btn" bindtap="load">重试</view></view>
  </block>
  <block wx:elif="{{pageState === 'empty'}}">
    <view class="state-wrap"><view class="state-icon">📭</view><view class="state-text">暂无协调提醒</view><view class="state-hint">约会协调有新进展时会在这里提醒你</view></view>
  </block>
  <block wx:else>
    <view class="notify-head">
      <view class="notify-title">协调提醒{{unreadCount ? (unreadCount + " 条未读") : ""}}</view>
      <button class="notify-mark-all" bindtap="onMarkAllRead" wx:if="{{unreadCount}}">全部已读</button>
    </view>
    <view class="notify-item card" wx:for="{{list}}" wx:key="id" bindtap="onTapItem" data-coordination-id="{{item.coordinationId}}">
      <view class="notify-icon">{{item.icon}}</view>
      <view class="notify-body">
        <view class="notify-title-row">
          <text class="notify-item-title">{{item.title}}</text>
          <text class="notify-time">{{item.timeText}}</text>
        </view>
        <view class="notify-item-body">{{item.body}}</view>
      </view>
      <view class="notify-unread-dot" wx:if="{{item.unread}}"></view>
      <view class="notify-arrow">›</view>
    </view>
  </block>
</view>
