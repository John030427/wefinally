<view class="register-page container">
  <block wx:if="{{pageState === 'loading'}}">
    <view class="state-wrap">
      <view class="state-icon">⏳</view>
      <view class="state-text">正在加载...</view>
    </view>
  </block>

  <block wx:elif="{{pageState === 'no-network'}}">
    <view class="state-wrap">
      <view class="state-icon">📡</view>
      <view class="state-text">网络不可用</view>
      <view class="state-btn" bindtap="onRetry">重新加载</view>
    </view>
  </block>

  <block wx:elif="{{pageState === 'error'}}">
    <view class="state-wrap">
      <view class="state-icon">⚠️</view>
      <view class="state-text">{{errorMsg || '加载失败'}}</view>
      <view class="state-btn" bindtap="onRetry">重新加载</view>
    </view>
  </block>

  <block wx:else>
    <view class="page-title">完善个人资料</view>
    <view class="page-subtitle">所有信息通过下拉选择填写</view>

    <view class="card">
      <view class="form-item">
        <text class="form-label required">性别</text>
        <picker mode="selector" range="{{genderOptions}}" value="{{form.genderIndex}}" bindchange="onPickerChange" data-field="gender">
          <view class="picker-value {{form.gender ? '' : 'placeholder'}}">{{form.gender || '请选择性别'}}</view>
        </picker>
      </view>

      <view class="form-item">
        <text class="form-label required">出生年份</text>
        <picker mode="selector" range="{{birthYearOptions}}" value="{{form.birthYearIndex}}" bindchange="onPickerChange" data-field="birthYear">
          <view class="picker-value {{form.birthYear ? '' : 'placeholder'}}">{{form.birthYear || '请选择出生年份'}}</view>
        </picker>
      </view>

      <view class="form-item">
        <text class="form-label required">身高</text>
        <picker mode="selector" range="{{heightOptions}}" value="{{form.heightIndex}}" bindchange="onPickerChange" data-field="height">
          <view class="picker-value {{form.height ? '' : 'placeholder'}}">{{form.height || '请选择身高'}}</view>
        </picker>
      </view>

      <view class="form-item">
        <text class="form-label required">学历</text>
        <picker mode="selector" range="{{educationOptions}}" value="{{form.educationIndex}}" bindchange="onPickerChange" data-field="education">
          <view class="picker-value {{form.education ? '' : 'placeholder'}}">{{form.education || '请选择学历'}}</view>
        </picker>
      </view>

      <view class="form-item">
        <text class="form-label required">职业圈层</text>
        <picker mode="selector" range="{{circleNames}}" value="{{form.circleIndex}}" bindchange="onPickerChange" data-field="circle">
          <view class="picker-value {{form.circleName ? '' : 'placeholder'}}">{{form.circleName || '请选择50大职业圈层'}}</view>
        </picker>
      </view>

      <view class="form-item">
        <text class="form-label required">工作城市</text>
        <picker mode="selector" range="{{cityOptions}}" value="{{form.cityIndex}}" bindchange="onPickerChange" data-field="city">
          <view class="picker-value {{form.city ? '' : 'placeholder'}}">{{form.city || '请选择城市'}}</view>
        </picker>
      </view>

      <view class="form-item">
        <text class="form-label required">婚姻状况</text>
        <picker mode="selector" range="{{marriageOptions}}" value="{{form.marriageIndex}}" bindchange="onPickerChange" data-field="marriage">
          <view class="picker-value {{form.marriage ? '' : 'placeholder'}}">{{form.marriage || '请选择婚姻状况'}}</view>
        </picker>
      </view>

      <view class="form-item">
        <text class="form-label required">婚育节奏</text>
        <picker mode="selector" range="{{babyPlanOptions}}" value="{{form.babyPlanIndex}}" bindchange="onPickerChange" data-field="babyPlan">
          <view class="picker-value {{form.babyPlan ? '' : 'placeholder'}}">{{form.babyPlan || '请选择婚育计划'}}</view>
        </picker>
      </view>

      <view class="form-item">
        <text class="form-label">年收入（选填）</text>
        <picker mode="selector" range="{{incomeOptions}}" value="{{form.incomeIndex}}" bindchange="onPickerChange" data-field="income">
          <view class="picker-value {{form.income ? '' : 'placeholder'}}">{{form.income || '请选择年收入'}}</view>
        </picker>
      </view>

      <view class="form-item">
        <text class="form-label">房车情况（选填）</text>
        <picker mode="selector" range="{{houseCarOptions}}" value="{{form.houseCarIndex}}" bindchange="onPickerChange" data-field="houseCar">
          <view class="picker-value {{form.houseCar ? '' : 'placeholder'}}">{{form.houseCar || '请选择房车情况'}}</view>
        </picker>
      </view>

      <view class="form-item" wx:if="{{form.promote_code}}">
        <text class="form-label">推广码</text>
        <view class="picker-value readonly">{{form.promote_code}}</view>
      </view>
    </view>

    <view class="safe-bottom">
      <button class="btn-primary" bindtap="onSubmit" disabled="{{submitting}}" loading="{{submitting}}">提交资料</button>
    </view>
  </block>
</view>
