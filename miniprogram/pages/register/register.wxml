<view class="register-page container">
  <block wx:if="{{pageState === 'loading'}}">
    <view class="state-wrap">
      <view class="state-icon">⏳</view>
      <view class="state-text">正在加载...</view>
    </view>
  </block>

  <block wx:elif="{{pageState === 'no-network'}}">
    <view class="state-wrap">
      <view class="state-icon">📡</view>
      <view class="state-text">网络不可用</view>
      <view class="state-btn" bindtap="onRetry">重新加载</view>
    </view>
  </block>

  <block wx:elif="{{pageState === 'error'}}">
    <view class="state-wrap">
      <view class="state-icon">⚠️</view>
      <view class="state-text">{{errorMsg || '加载失败'}}</view>
      <view class="state-btn" bindtap="onRetry">重新加载</view>
    </view>
  </block>

  <block wx:else>
    <view class="page-title">{{editMode ? '个人资料' : '完善个人资料'}}</view>
    <view class="page-subtitle">请选择真实资料，职业不在列表时可填写其他</view>

    <view class="card">
      <view class="form-item">
        <text class="form-label required">性别</text>
        <picker mode="selector" range="{{genderOptions}}" value="{{form.genderIndex}}" bindchange="onPickerChange" data-field="gender">
          <view class="picker-value {{form.gender ? '' : 'placeholder'}}">{{form.gender || '请选择性别'}}</view>
        </picker>
      </view>

      <view class="form-item">
        <text class="form-label required">出生年份</text>
        <picker mode="selector" range="{{birthYearOptions}}" value="{{form.birthYearIndex}}" bindchange="onPickerChange" data-field="birthYear">
          <view class="picker-value {{form.birthYear ? '' : 'placeholder'}}">{{form.birthYear || '请选择出生年份'}}</view>
        </picker>
      </view>

      <view class="form-item">
        <text class="form-label required">身高</text>
        <picker mode="selector" range="{{heightOptions}}" value="{{form.heightIndex}}" bindchange="onPickerChange" data-field="height">
          <view class="picker-value {{form.height ? '' : 'placeholder'}}">{{form.height || '请选择身高'}}</view>
        </picker>
      </view>

      <view class="form-item">
        <text class="form-label required">学历</text>
        <picker mode="selector" range="{{educationOptions}}" value="{{form.educationIndex}}" bindchange="onPickerChange" data-field="education">
          <view class="picker-value {{form.education ? '' : 'placeholder'}}">{{form.education || '请选择学历'}}</view>
        </picker>
      </view>

      <view class="form-item">
        <text class="form-label required">主要身份</text>
        <picker mode="multiSelector" range="{{circleMatrix}}" value="{{circleMultiIndex}}" bindcolumnchange="onCircleColumnChange" bindchange="onCircleChange">
          <view class="picker-value {{form.circleName ? '' : 'placeholder'}}">{{form.circleName || '请选择主要职业板块和圈层'}}</view>
        </picker>
      </view>
      <view class="form-item" wx:if="{{form.circleName === '其他'}}">
        <text class="form-label required">具体职业</text>
        <input class="text-input" value="{{form.occupationDescription}}" placeholder="请输入你的职业，例如：工业设计师" maxlength="100" bindinput="onOccupationDescriptionInput" />
      </view>
      <view class="form-item" wx:if="{{secondaryIdentityOptions.length}}">
        <text class="form-label">其他符合身份（最多2个）</text>
        <view class="identity-chip-list">
          <view
            class="identity-chip {{item.selected ? 'selected' : ''}}"
            wx:for="{{secondaryIdentityOptions}}"
            wx:key="id"
            data-id="{{item.id}}"
            bindtap="toggleSecondaryIdentity"
          >{{item.name}}</view>
        </view>
        <view class="form-hint">学历仍单独填写；身份用于理解背景，不影响推广归属。</view>
      </view>

      <view class="form-item">
        <text class="form-label required">工作省份</text>
        <picker mode="selector" range="{{provinceNames}}" value="{{form.provinceIndex}}" bindchange="onProvinceChange">
          <view class="picker-value {{form.provinceName ? '' : 'placeholder'}}">{{form.provinceName || '请选择省份'}}</view>
        </picker>
      </view>
      <view class="form-item">
        <text class="form-label required">工作城市</text>
        <picker mode="selector" range="{{cityOptions}}" value="{{form.cityIndex}}" bindchange="onCityChange" disabled="{{!form.provinceCode}}">
          <view class="picker-value {{form.city ? '' : 'placeholder'}}">{{form.city || (form.provinceCode ? '请选择城市' : '请先选择省份')}}</view>
        </picker>
      </view>

      <view class="form-item">
        <text class="form-label required">婚姻状况</text>
        <picker mode="selector" range="{{marriageOptions}}" value="{{form.marriageIndex}}" bindchange="onPickerChange" data-field="marriage">
          <view class="picker-value {{form.marriage ? '' : 'placeholder'}}">{{form.marriage || '请选择婚姻状况'}}</view>
        </picker>
      </view>

      <view class="form-item">
        <text class="form-label required">婚育节奏</text>
        <picker mode="selector" range="{{babyPlanOptions}}" value="{{form.babyPlanIndex}}" bindchange="onPickerChange" data-field="babyPlan">
          <view class="picker-value {{form.babyPlan ? '' : 'placeholder'}}">{{form.babyPlan || '请选择婚育计划'}}</view>
        </picker>
      </view>

      <view class="form-item">
        <text class="form-label">年收入（选填）</text>
        <picker mode="selector" range="{{incomeOptions}}" value="{{form.incomeIndex}}" bindchange="onPickerChange" data-field="income">
          <view class="picker-value {{form.income ? '' : 'placeholder'}}">{{form.income || '请选择年收入'}}</view>
        </picker>
      </view>

      <view class="form-item">
        <text class="form-label">房车情况（选填）</text>
        <picker mode="selector" range="{{houseCarOptions}}" value="{{form.houseCarIndex}}" bindchange="onPickerChange" data-field="houseCar">
          <view class="picker-value {{form.houseCar ? '' : 'placeholder'}}">{{form.houseCar || '请选择房车情况'}}</view>
        </picker>
      </view>

      <view class="form-item">
        <text class="form-label">我的外貌描述（选填）</text>
        <textarea
          class="textarea-input"
          placeholder="例如：中等偏高，日常穿搭简洁，气质清爽..."
          maxlength="{{appearanceMaxLen}}"
          value="{{form.appearanceDescription}}"
          bindinput="onAppearanceDescriptionInput"
          show-confirm-bar="{{false}}"
        />
        <view class="char-counter">当前 {{appearanceDescriptionLen}} / {{appearanceMaxLen}} 字</view>
      </view>

      <view class="form-item">
        <text class="form-label">公开邀请码（选填）</text>
        <view class="promo-row">
          <input class="promo-input" value="{{form.promote_code}}" placeholder="有邀请码可填写，没有可直接注册" maxlength="50" disabled="{{editMode}}" bindinput="onPromoteInput" bindblur="onPromoteBlur" />
          <view wx:if="{{form.promote_code && !editMode}}" class="promo-clear" bindtap="onPromoteClear">清空</view>
        </view>
        <view class="promo-hint">用于确认邀请来源，不会自动成为合伙人</view>
        <view wx:if="{{promoMessage || checkingPromo}}" class="promo-hint {{promoStatus}}">{{checkingPromo ? '校验中...' : promoMessage}}</view>
      </view>
    </view>

    <view class="safe-bottom">
      <button class="btn-primary" bindtap="onSubmit" disabled="{{submitting}}" loading="{{submitting}}">{{editMode ? '保存修改' : '提交资料'}}</button>
    </view>
  </block>
</view>
