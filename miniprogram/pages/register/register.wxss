.form-label.required::after {
  content: ' *';
  color: #ff6b8a;
}

.picker-value.readonly {
  background: #fafafa;
  color: #888;
}

.promo-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.promo-input {
  flex: 1;
  min-width: 0;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 0 32rpx;
  height: 88rpx;
  color: #333333;
  font-size: 28rpx;
  box-sizing: border-box;
}

.text-input {
  width: 100%;
  height: 88rpx;
  padding: 0 28rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  box-sizing: border-box;
}

.promo-clear {
  flex: 0 0 auto;
  color: #ff6b8a;
  font-size: 26rpx;
  padding: 20rpx 0;
}

.promo-hint {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #888888;
}

.identity-chip-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.identity-chip {
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: #f5f5f5;
  color: #666;
  font-size: 24rpx;
}

.identity-chip.selected {
  background: #fff0f3;
  color: #ff6b8a;
  border: 1rpx solid #ffb3c3;
}

.form-hint {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #999;
  line-height: 1.6;
}

.promo-hint.success {
  color: #2f9d62;
}

.promo-hint.error {
  color: #ff6b8a;
}
