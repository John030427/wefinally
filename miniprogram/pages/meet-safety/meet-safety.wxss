.form-card {
  padding-bottom: 32rpx;
}

.form-label {
  font-size: 26rpx;
  color: #555;
  margin-bottom: 12rpx;
}

.input {
  height: 80rpx;
  padding: 0 24rpx;
  border-radius: 8rpx;
  background: #f8f8f8;
  font-size: 28rpx;
}

.textarea {
  width: 100%;
  min-height: 160rpx;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
  border-radius: 8rpx;
  background: #f8f8f8;
  font-size: 28rpx;
}

.loc-btn {
  margin: 0;
}

.loc-text {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #888;
}

.ack-row {
  display: flex;
  gap: 12rpx;
  align-items: flex-start;
  margin: 24rpx 0;
  font-size: 24rpx;
  color: #666;
  line-height: 1.6;
}

.checkbox {
  width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  border: 2rpx solid #ff6b8a;
  border-radius: 6rpx;
  color: #ff6b8a;
  flex: none;
}

.submit-btn,
.share-btn {
  margin-top: 24rpx;
}

.safety-card {
  text-align: left;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.card-no {
  margin: 8rpx 0 24rpx;
  font-size: 24rpx;
  color: #999;
}

.info-row {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  font-size: 26rpx;
  color: #555;
}

.info-row text:last-child {
  color: #333;
  text-align: right;
}

.note {
  margin-top: 24rpx;
  font-size: 24rpx;
  color: #666;
  line-height: 1.7;
}

.sos-btn {
  margin-top: 24rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 8rpx;
  background: #e53935;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
}
