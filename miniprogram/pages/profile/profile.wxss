.user-header {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.user-avatar-text {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ff6b8a, #ffb3c1);
  color: #fff;
  font-size: 36rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.user-info {
  flex: 1;
}

.user-tags {
  margin-bottom: 8rpx;
}

.tag-vip {
  background: #fff0f3;
  color: #ff6b8a;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  font-size: 22rpx;
}

.user-meta {
  font-size: 24rpx;
  color: #888;
  line-height: 1.6;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.menu-title {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.menu-arrow {
  font-size: 32rpx;
  color: #ccc;
}

.logout-btn {
  margin-top: 32rpx;
  width: 100%;
}

.readiness-card {
  border: 2rpx solid #f1e8e9;
}

.readiness-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.readiness-kicker {
  color: #3e8e6b;
  font-size: 22rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.readiness-title {
  color: #231f20;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.4;
}

.readiness-score {
  flex: 0 0 auto;
  color: #ff6b8a;
  font-size: 40rpx;
  font-weight: 700;
}

.readiness-track {
  height: 14rpx;
  border-radius: 7rpx;
  background: #f4edef;
  overflow: hidden;
  margin-top: 24rpx;
}

.readiness-fill {
  height: 100%;
  border-radius: 7rpx;
  background: linear-gradient(90deg, #ff6b8a, #3e8e6b);
}

.readiness-missing,
.readiness-ready {
  margin-top: 18rpx;
  color: #7b7274;
  font-size: 23rpx;
  line-height: 1.6;
}

.readiness-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 20rpx;
}

.readiness-action {
  padding: 15rpx 22rpx;
  border-radius: 12rpx;
  background: #ff6b8a;
  color: #fff;
  font-size: 23rpx;
}

.readiness-action.secondary {
  background: #fff0f3;
  color: #a9435a;
}
