<view class="profile-page container">
  <state-view wx:if="{{pageState === 'loading'}}" type="loading" />
  <state-view
    wx:elif="{{pageState === 'no-network'}}"
    type="network"
    desc="请检查网络后重新加载"
    bind:action="onRetry"
  />
  <state-view
    wx:elif="{{pageState === 'error'}}"
    type="error"
    title="加载失败了"
    desc="{{errorMsg}}"
    bind:action="onRetry"
  />

  <block wx:else>
    <!-- 个人卡 -->
    <view class="user-card card">
      <view class="user-header">
        <view class="user-avatar-text">{{userInfo.display.gender || '用'}}</view>
        <view class="user-info">
          <view class="user-tags">
            <text class="tag tag-pink">{{userInfo.display.gender}}</text>
            <text class="tag tag-gray">{{userInfo.display.age}}岁</text>
            <text class="tag tag-vip" wx:if="{{isVip}}">VIP</text>
            <text class="tag tag-vip" wx:if="{{userInfo.free_member}}">已激活</text>
          </view>
          <view class="user-meta">{{userInfo.display.city}} · {{userInfo.display.education}}</view>
          <view class="user-meta">{{userInfo.display.circleName}} · {{userInfo.display.babyPlan}}</view>
          <view class="user-edit-link" bindtap="editBaseProfile" hover-class="user-edit-link-pressed">
            <view class="wf-icon wf-icon-edit icon-sm user-edit-icon"></view>
            <text>编辑资料</text>
          </view>
          <view class="user-support-code">用户ID {{userInfo.support_code || '正在分配'}}</view>
        </view>
      </view>
    </view>

    <!-- 资料就绪度：被理解的前提 -->
    <view class="readiness-card card" wx:if="{{readiness}}">
      <view class="readiness-head">
        <view>
          <view class="readiness-kicker">匹配资料就绪度</view>
          <view class="readiness-title">{{readiness.isComplete ? '资料已就绪' : readiness.hint}}</view>
        </view>
        <view class="readiness-score">{{readiness.percent}}%</view>
      </view>
      <view class="readiness-track">
        <view class="readiness-fill" style="width: {{readiness.percent}}%"></view>
      </view>
      <view class="readiness-missing" wx:if="{{!readiness.isComplete}}">
        缺失：{{readiness.missingText}}
      </view>
      <view class="readiness-actions" wx:if="{{!readiness.isComplete}}">
        <view class="readiness-action" bindtap="editBaseProfile" hover-class="user-edit-link-pressed">完善基本资料</view>
        <view class="readiness-action secondary" bindtap="editMatchProfile" hover-class="user-edit-link-pressed">完善择偶与价值观</view>
      </view>
      <view class="readiness-ready" wx:else>资料会用于硬性筛选和双向评分，你可以随时更新。</view>
    </view>

    <!-- 合伙人工作台（业务入口保留） -->
    <view class="partner-workspace card state-{{partnerStatus.state}}" bindtap="openPartnerWorkspace" hover-class="row-card-pressed">
      <view class="partner-workspace-icon">
        <view class="wf-icon wf-icon-heart icon-lg"></view>
      </view>
      <view class="partner-workspace-copy">
        <view class="partner-workspace-kicker">WEFINALLY PARTNER</view>
        <view class="partner-workspace-title" wx:if="{{partnerStatus.state === 'active'}}">合伙人工作台</view>
        <view class="partner-workspace-title" wx:elif="{{partnerStatus.state === 'pending'}}">合伙人申请审核中</view>
        <view class="partner-workspace-title" wx:elif="{{partnerStatus.state === 'needs_verification'}}">合伙人资格待手机号验证</view>
        <view class="partner-workspace-title" wx:elif="{{partnerStatus.state === 'suspended'}}">合伙人权限已暂停</view>
        <view class="partner-workspace-title" wx:elif="{{partnerStatus.state === 'rejected'}}">当前没有可激活资格</view>
        <view class="partner-workspace-title" wx:elif="{{partnerStatus.state === 'revoked'}}">合伙人资格已撤销</view>
        <view class="partner-workspace-title" wx:else>合作合伙人入口</view>
        <view class="partner-workspace-desc" wx:if="{{partnerStatus.state === 'active'}}">查看邀请转化、收入与分享素材</view>
        <view class="partner-workspace-desc" wx:elif="{{partnerStatus.state === 'pending'}}">历史申请正在处理；当前仅开放已有合作名单激活</view>
        <view class="partner-workspace-desc" wx:elif="{{partnerStatus.review_note}}">{{partnerStatus.review_note}}</view>
        <view class="partner-workspace-desc" wx:else>已有合作合伙人可输入名单手机号激活</view>
      </view>
      <view class="wf-icon wf-icon-arrow icon-sm icon-hint"></view>
    </view>

    <!-- 分组菜单 -->
    <view class="menu-group card" wx:for="{{menuGroups}}" wx:for-item="group" wx:key="title">
      <view class="menu-group-title">{{group.title}}</view>
      <view
        class="menu-item"
        wx:for="{{group.items}}"
        wx:key="title"
        bindtap="onMenuTap"
        data-url="{{item.url}}"
        data-action="{{item.action}}"
        hover-class="menu-item-pressed"
      >
        <view class="menu-icon-wrap">
          <view class="wf-icon {{item.icon}} icon-sm menu-icon"></view>
        </view>
        <text class="menu-title">{{item.title}}</text>
        <view class="wf-icon wf-icon-arrow icon-sm icon-hint"></view>
      </view>
    </view>

    <button class="logout-btn" bindtap="onLogout">
      <view class="wf-icon wf-icon-logout icon-sm logout-icon"></view>
      <text>退出登录</text>
    </button>
  </block>
</view>
