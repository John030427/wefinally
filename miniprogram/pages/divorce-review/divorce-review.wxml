<view class="divorce-review-page container">
  <block wx:if="{{pageState === 'loading'}}">
    <view class="state-wrap">
      <view class="state-icon">⏳</view>
      <view class="state-text">正在加载...</view>
    </view>
  </block>

  <block wx:elif="{{pageState === 'no-network'}}">
    <view class="state-wrap">
      <view class="state-icon">📡</view>
      <view class="state-text">网络不可用</view>
      <view class="state-btn" bindtap="onRetry">重新加载</view>
    </view>
  </block>

  <block wx:elif="{{pageState === 'error'}}">
    <view class="state-wrap">
      <view class="state-icon">⚠️</view>
      <view class="state-text">{{message || '加载失败'}}</view>
      <view class="state-btn" bindtap="onRetry">重新加载</view>
    </view>
  </block>

  <block wx:else>
    <view class="page-title">离异复入申请</view>
    <view class="page-subtitle">平台人工审核后处理复入资格</view>

    <view class="card status-card">
      <view class="status-row">
        <text class="status-label">当前状态</text>
        <text class="status-pill {{status}}">{{statusText}}</text>
      </view>
      <view class="status-message">{{message || '尚未提交离异复入申请'}}</view>
      <view wx:if="{{rejectReason}}" class="reject-reason">驳回原因：{{rejectReason}}</view>
    </view>

    <view class="card notice-card">
      <view class="notice-title">申请说明</view>
      <text class="notice-item">· 离异用户需先完成复入审核，不能直接进入普通注册</text>
      <text class="notice-item">· 用户端不上传离婚证明，证明材料由客服或后台处理</text>
      <text class="notice-item">· 审核通过后仍需平台人工开通，不自动进入匹配池</text>
    </view>

    <view wx:if="{{showForm}}" class="card">
      <view class="form-item">
        <text class="form-label required">联系电话</text>
        <input class="text-input" type="number" maxlength="11" value="{{contact_phone}}" placeholder="请输入 11 位手机号" bindinput="onPhoneInput" />
      </view>

      <view class="form-item">
        <text class="form-label">备注说明（选填）</text>
        <textarea class="textarea-input" maxlength="200" value="{{review_note}}" placeholder="可简要说明情况，客服会跟进处理" bindinput="onNoteInput" />
      </view>
    </view>

    <view class="safe-bottom action-stack">
      <button wx:if="{{showForm}}" class="btn-primary" bindtap="onSubmit" loading="{{submitting}}" disabled="{{submitting}}">
        提交申请
      </button>
      <button class="btn-secondary" bindtap="goChat">
        联系平台客服
      </button>
    </view>
  </block>
</view>
