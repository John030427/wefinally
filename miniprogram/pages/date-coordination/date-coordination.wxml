<view class="date-page container">
  <block wx:if="{{pageState === 'loading'}}">
    <view class="state-wrap"><view class="state-text">正在准备约会协调...</view></view>
  </block>

  <block wx:elif="{{pageState === 'no-network'}}">
    <view class="state-wrap"><view class="state-text">网络不可用</view><view class="state-btn" bindtap="onRetry">重试</view></view>
  </block>

  <block wx:elif="{{pageState === 'error'}}">
    <view class="state-wrap"><view class="state-text">{{errorMsg}}</view><view class="state-btn" bindtap="onRetry">重试</view></view>
  </block>

  <block wx:elif="{{pageState === 'expired'}}">
    <view class="state-wrap"><view class="state-text">本次约会邀请暂未得到回应，协调已结束。</view><view class="state-btn" bindtap="goService">联系平台客服</view></view>
  </block>

  <block wx:elif="{{pageState === 'fixture-simulation'}}">
    <view class="date-head card">
      <view class="date-title">约会申请进度</view>
      <view class="date-desc">{{fixtureStatusText}}</view>
      <view class="status-pill">{{fixtureStage === 'completed' ? '已反馈' : (fixtureStage === 'generating' ? '处理中' : '待处理')}}</view>
    </view>
    <view class="progress-card card coordination-track">
      <view class="section-title">AI协调进度</view>
      <view class="coordination-step done"><view class="step-dot"></view><view><view class="step-title">约会申请已提交</view><view class="step-desc">系统已经保存你的时间、区域和活动偏好</view></view></view>
      <view class="coordination-step {{fixtureStage === 'generating' || fixtureStage === 'completed' ? 'done' : 'active'}}"><view class="step-dot"></view><view><view class="step-title">AI协调处理中</view><view class="step-desc">{{fixtureStage === 'queued' ? 'AI协调任务已进入队列，可离开页面，后台会继续处理' : '正在整理协调结果，请稍候'}}</view></view></view>
      <view class="coordination-step {{fixtureStage === 'completed' ? 'done' : ''}}"><view class="step-dot"></view><view><view class="step-title">协调结果反馈</view><view class="step-desc">{{fixtureStage === 'completed' ? '协调结果已经生成' : '完成后会在本页显示反馈'}}</view></view></view>
    </view>
    <view class="invite-card card">
      <view class="section-title">AI协调反馈</view>
      <view class="invite-text" wx:if="{{fixtureResponseMessage}}">{{fixtureResponseMessage}}</view>
      <view class="muted" wx:else>{{fixtureStage === 'generating' ? '正在整理协调结果，请稍候。' : 'AI协调任务已进入队列。你可以先离开，稍后回来查看结果。'}}</view>
      <button class="outline-btn full-btn" bindtap="refreshFixtureSimulation" loading="{{refreshingFixture}}">刷新协调进度</button>
    </view>
  </block>

  <block wx:else>
    <view class="date-head card">
      <view class="test-data-badge" wx:if="{{coordination.test_data_badge || coordination.is_test_data}}">{{coordination.test_data_badge || '测试数据'}}</view>
      <view class="date-title">第一次约会</view>
      <view class="date-desc" wx:if="{{coordination.status === 'collecting_initiator'}}">先提出你建议的第一次约会安排，保存后会邀请对方回应。</view>
      <view class="date-desc" wx:elif="{{coordinationDisplay.waitingPartner}}">约会邀请已发送。当前正在等待对方回应。</view>
      <view class="date-desc" wx:elif="{{coordinationDisplay.receivedInvitation}}">对方建议了一次轻松、安全的初次见面。你可以接受、和 AI 协调，或这次暂不方便。</view>
      <view class="date-desc" wx:else>事实显示在卡片上。AI 只负责解释、询问和协调还没解决的差异。</view>
      <view class="status-pill">{{coordinationDisplay.statusText}}</view>
    </view>

    <view class="current-plan-card card" wx:if="{{currentPlanCard}}">
      <view class="plan-card-head">
        <view>
          <view class="plan-kicker">当前有效版本 · V{{coordinationDisplay.version}}</view>
          <view class="section-title">AI 协调方案</view>
        </view>
        <view class="plan-ready-pill {{currentPlanCard.meeting_ready ? 'ready' : 'pending'}}">{{currentPlanCard.meeting_ready ? '可以赴约' : '待补充'}}</view>
      </view>
      <view class="plan-conflict" wx:if="{{currentPlanCard.meeting_conflict}}">{{currentPlanCard.meeting_conflict.message}}</view>
      <view class="fact-row"><text class="fact-label">时间</text><text class="fact-value">{{currentPlanCard.time_text || '待确认'}}</text></view>
      <view class="fact-row"><text class="fact-label">活动</text><text class="fact-value">{{currentPlanCard.activity_text || '待确认'}}</text></view>
      <view class="fact-row"><text class="fact-label">活动场地</text><text class="fact-value">{{currentPlanCard.activity_venue_text || '待确认'}}</text></view>
      <view class="fact-row"><text class="fact-label">初步会合范围</text><text class="fact-value">{{currentPlanCard.meet_point_text || '到场前再确认'}}</text></view>
      <view class="fact-row"><text class="fact-label">区域</text><text class="fact-value">{{currentPlanCard.area_text || '待确认'}}</text></view>
      <view class="fact-row"><text class="fact-label">预算 / 费用</text><text class="fact-value">{{currentPlanCard.budget_text || '待确认'}} · {{currentPlanCard.payment_text || '待确认'}}</text></view>
      <view class="fact-row"><text class="fact-label">时长</text><text class="fact-value">{{currentPlanCard.duration_text || '待确认'}}</text></view>
      <view class="plan-safe-note">双方确认的是同一版本；关键安排改变后，需要重新确认。</view>
      <button class="outline-btn full-btn" wx:if="{{showCoordinatorCta && (currentPlanCard.meeting_conflict || !currentPlanCard.meeting_ready)}}" bindtap="goCoordinator">让 AI 帮我补齐或澄清</button>
    </view>

    <view class="meeting-card card" wx:if="{{meetingCheckin && meetingCheckin.enabled}}">
      <view class="section-title">到场会合</view>
      <view class="public-note">AI 只负责转达双方主动提供的信息，不能验证现实身份。到达活动场地后，可以再告诉对方自己在吧台、靠窗等公共位置。</view>
      <view class="plan-conflict" wx:if="{{meetingCheckin.meeting_paused}}">会合已因现场情况不符而暂停。请停止接触并联系平台人工客服；恢复必须经过人工审核。</view>
      <view class="arrival-status-row"><text>我的状态</text><text>{{meetingCheckin.my_arrived ? '已到达' : '尚未到达'}}</text></view>
      <view class="arrival-status-row"><text>对方状态</text><text>{{meetingCheckin.partner_arrived ? '已到达' : '尚未到达'}}</text></view>
      <view class="meeting-code" wx:if="{{meetingCheckin.meeting_code}}"><text>会合暗号</text><text class="meeting-code-value">{{meetingCheckin.meeting_code}}</text></view>
      <view class="partner-hint" wx:if="{{meetingCheckin.partner_arrival_hint}}">对方主动提供：{{meetingCheckin.partner_arrival_hint}}</view>
      <view class="partner-hint" wx:if="{{meetingCheckin.partner_arrival_position}}">对方现在位于：{{meetingCheckin.partner_arrival_position}}</view>
      <view class="form-item">
        <view class="form-label">现场位置（选填）</view>
        <input class="input field-input" maxlength="40" placeholder="例如：星巴克吧台旁、靠窗座位" value="{{arrivalPosition}}" bindinput="onArrivalPositionInput" />
        <view class="field-help">只填写公共场所内容易找到的位置，不填写实时定位或详细地址。</view>
      </view>
      <view class="form-item">
        <view class="form-label">我的到场识别提示</view>
        <input class="input field-input" maxlength="60" placeholder="例如：深色上衣，手持一本书" value="{{form.arrival_hint}}" bindinput="onArrivalHintInput" />
        <button class="outline-btn full-btn" bindtap="updateArrivalHint" disabled="{{submitting || meetingCheckin.meeting_paused}}">同步给对方</button>
      </view>
      <button class="primary-btn full-btn" bindtap="markArrived" disabled="{{submitting || meetingCheckin.meeting_paused}}">{{meetingCheckin.my_arrived ? '更新到场位置并通知对方' : '我已到达，通知对方'}}</button>
      <view class="meeting-actions">
        <button class="outline-btn" bindtap="confirmMet" disabled="{{submitting || !meetingCheckin.can_confirm_met || meetingCheckin.my_met_confirmed || meetingCheckin.meeting_paused}}">已见到对方</button>
        <button class="outline-btn" bindtap="reportNotFound" disabled="{{submitting || meetingCheckin.meeting_paused}}">暂未找到</button>
      </view>
      <button class="text-btn full-btn danger-text" bindtap="reportMismatch" disabled="{{submitting}}">现场情况不符，暂停会合</button>
    </view>

    <view class="result-card card" wx:if="{{resultCard}}">
      <view class="section-title">{{resultCard.title || '邀请结果'}}</view>
      <view class="invite-text">{{resultCard.body || coordination.declined_public_message || '对方暂未接受本次约会邀请。'}}</view>
      <view class="muted" wx:if="{{coordination.status === 'invitation_declined' || coordination.status === 'expired'}}">本次协调已结束，不能继续修改安排。</view>
    </view>

    <view class="processing-card card" wx:if="{{coordinationDisplay.processing}}">
      <view class="section-title">{{coordinationDisplay.queued ? '协调任务待处理' : '正在计算共同方案'}}</view>
      <view class="public-note">{{coordinationDisplay.queued ? '任务已进入后台队列，可以先离开页面；完成后本页会自动更新。' : '后台正在核对双方当前版本的共同时间、区域和活动。'}}</view>
    </view>

    <view class="processing-card processing-card-failed card" wx:if="{{coordinationDisplay.failed}}">
      <view class="section-title">本轮处理暂时失败</view>
      <view class="public-note">你的申请仍然保留，可以重新进入队列；如果持续失败，请联系人工客服。</view>
      <button class="primary-btn full-btn" bindtap="retryProcessing" loading="{{submitting}}">重新处理</button>
    </view>

    <view class="processing-card card" wx:if="{{coordinationDisplay.manualHandoff}}">
      <view class="section-title">自动协调已转人工</view>
      <view class="public-note">已经完成 5 轮自动协调。平台客服会基于安全摘要继续协助，不会替任何一方作决定。</view>
      <button class="outline-btn full-btn" bindtap="goService">联系人工客服</button>
    </view>

    <view class="invite-actions card" wx:if="{{showAcceptInvitation || showCoordinateInstead || showDecline}}">
      <view class="section-title">选择一种回应方式</view>
      <view class="response-option-copy" wx:if="{{showAcceptInvitation}}">时间、区域、活动等都可以，直接接受整份方案。</view>
      <button class="primary-btn full-btn" wx:if="{{showAcceptInvitation}}" bindtap="respondInvitation" data-decision="accept" loading="{{responding}}">接受完整方案</button>
      <view class="response-option-copy" wx:if="{{showCoordinateInstead}}">大部分安排可以，只告诉 AI 需要改变的项目。</view>
      <button class="outline-btn full-btn" wx:if="{{showCoordinateInstead}}" bindtap="respondInvitation" data-decision="coordinate" loading="{{responding}}">只调整部分安排</button>
      <button class="text-btn full-btn" wx:if="{{showDecline}}" bindtap="respondInvitation" data-decision="decline" loading="{{responding}}">这次暂不方便</button>
    </view>

    <view class="fact-card card" wx:if="{{sharedCoordination.ready}}">
      <view class="section-title">当前协调情况</view>
      <view class="fact-row" wx:for="{{sharedCoordination.dimensions}}" wx:key="key">
        <text class="fact-mark {{item.status === 'agreed' ? 'ok' : 'warn'}}">{{item.status === 'agreed' ? '✓' : '⚠'}}</text>
        <text class="fact-label">{{item.label}}</text>
        <text class="fact-value">{{item.display}}</text>
      </view>
    </view>

    <view class="coordinator-hero card pre-submit-card" wx:if="{{showPreSubmitCoordinatorCard}}">
      <view class="section-title">AI约会协调</view>
      <view class="public-note">提交约会邀请后，你可以随时和 AI 协调员补充或修改安排。</view>
      <view class="ai-disclosure">AI生成内容，仅供参考</view>
    </view>

    <view class="coordinator-hero card" wx:if="{{showCoordinatorCta}}">
      <view class="section-title">{{coordination.status === 'inviting_partner' ? '和 AI 约会协调员沟通' : 'AI约会协调'}}</view>
      <view class="public-note">{{coordinatorHeroText}}</view>
      <view class="ai-disclosure">AI生成内容，仅供参考</view>
      <button class="primary-btn full-btn" bindtap="goCoordinator">和 AI 约会协调员沟通</button>
      <view class="muted coordinator-hint">已经一致的条件不会再重复询问。修改前会先展示预览。</view>
      <button class="outline-btn compact-btn" bindtap="onEnableSubscribe">开启协调提醒</button>
      <button class="outline-btn compact-btn" bindtap="refreshCoordination" loading="{{refreshingCoordination}}">刷新最新状态</button>
      <button class="outline-btn compact-btn" wx:if="{{showAdvanceSynthetic}}" bindtap="advanceSynthetic" loading="{{advancingSynthetic}}">推进测试对象（分步）</button>
    </view>

    <view class="form-card card" wx:if="{{showApplicationForm}}">
      <view class="section-title">{{coordination.status === 'collecting_initiator' ? '填写第一次约会建议' : '完整填写我的安排'}}</view>
      <view class="form-hint" wx:if="{{coordination.status === 'collecting_initiator'}}">提交后会邀请对方。这表示你愿意按当前建议参加，但还不是最终确认。</view>
      <view class="form-item">
        <view class="form-label required">📅 可约时间（本次建议日期）</view>
        <picker mode="date" start="{{dateMin}}" end="{{dateMax}}" value="{{selectedDate}}" bindchange="onDateChange">
          <view class="picker-value">未来14天内选择日期</view>
        </picker>
        <view class="date-choice" wx:for="{{form.availability}}" wx:for-item="dateItem" wx:key="date">
          <view class="date-choice-head">
            <text>{{dateItem.date}}</text>
            <text class="remove-date" bindtap="removeAvailability" data-value="{{dateItem.date}}">移除</text>
          </view>
          <view class="form-label">🕰 可约时间段（本次单选）</view>
          <view class="choice-list">
            <view class="choice-tag {{selection.periods[dateItem.date] && selection.periods[dateItem.date][periodItem.value] ? 'selected' : ''}}" wx:for="{{periodOptions}}" wx:for-item="periodItem" wx:key="value" bindtap="togglePeriod" data-date="{{dateItem.date}}" data-period="{{periodItem.value}}" hover-class="choice-tag-pressed">{{periodItem.label}}</view>
          </view>
          <view class="selected-periods">已选择：{{dateItem.periods}}</view>
        </view>
      </view>
      <view class="form-item">
        <view class="form-label required">📍 偏好区域（本次单选）</view>
        <input class="input field-input" placeholder="例如：南山区" value="{{areaText}}" bindinput="onAreasInput" />
        <view class="field-help">填写一个区域；如需改动，可在 AI 协调会话中提出新方案。</view>
      </view>
      <view class="form-item">
        <view class="form-label required">🎯 活动偏好（本次单选）</view>
        <view class="choice-list">
          <view class="choice-tag {{selection.activities[item.value] ? 'selected' : ''}}" wx:for="{{activityOptions}}" wx:key="value" bindtap="toggleActivity" data-value="{{item.value}}" hover-class="choice-tag-pressed">{{item.label}}</view>
        </view>
        <view class="selected-periods">已选择：{{form.activities}}</view>
      </view>
      <view class="form-item">
        <view class="form-label required">💰 人均预算</view>
        <view class="choice-list"><view class="choice-tag {{form.budget === item.value ? 'selected' : ''}}" wx:for="{{budgetOptions}}" wx:key="value" bindtap="selectOption" data-key="budget" data-value="{{item.value}}" hover-class="choice-tag-pressed">{{item.label}}</view></view>
      </view>
      <view class="form-item">
        <view class="form-label required">🤝 费用方式</view>
        <view class="choice-list"><view class="choice-tag {{form.payment_preference === item.value ? 'selected' : ''}}" wx:for="{{paymentOptions}}" wx:key="value" bindtap="selectOption" data-key="payment_preference" data-value="{{item.value}}" hover-class="choice-tag-pressed">{{item.label}}</view></view>
      </view>
      <view class="form-item">
        <view class="form-label required">⏳ 可接受时长</view>
        <view class="choice-list"><view class="choice-tag {{form.duration === item.value ? 'selected' : ''}}" wx:for="{{durationOptions}}" wx:key="value" bindtap="selectOption" data-key="duration" data-value="{{item.value}}" hover-class="choice-tag-pressed">{{item.label}}</view></view>
      </view>
      <block wx:if="{{coordination.status === 'collecting_initiator' && primaryOptions.needsExplicit}}">
        <view class="form-item">
          <view class="form-label required">⭐ 本次建议安排</view>
          <view class="field-help">可接受范围可以有多个；请再明确这次优先建议哪一个，对方会先看到这份建议。</view>
          <view class="form-label">本次建议时间</view>
          <view class="choice-list">
            <view class="choice-tag {{primaryProposal.date === item.date && primaryProposal.period === item.period ? 'selected' : ''}}" wx:for="{{primaryOptions.slots}}" wx:key="key" bindtap="selectPrimarySlot" data-date="{{item.date}}" data-period="{{item.period}}" hover-class="choice-tag-pressed">{{item.date}} {{item.period}}</view>
          </view>
          <view class="form-label" wx:if="{{primaryOptions.areas.length > 1}}">本次建议区域</view>
          <view class="choice-list" wx:if="{{primaryOptions.areas.length > 1}}">
            <view class="choice-tag {{primaryProposal.area === item ? 'selected' : ''}}" wx:for="{{primaryOptions.areas}}" wx:key="*this" bindtap="selectPrimaryArea" data-value="{{item}}" hover-class="choice-tag-pressed">{{item}}</view>
          </view>
          <view class="form-label" wx:if="{{primaryOptions.activities.length > 1}}">本次建议活动</view>
          <view class="choice-list" wx:if="{{primaryOptions.activities.length > 1}}">
            <view class="choice-tag {{primaryProposal.activity === item ? 'selected' : ''}}" wx:for="{{primaryOptions.activities}}" wx:key="*this" bindtap="selectPrimaryActivity" data-value="{{item}}" hover-class="choice-tag-pressed">{{item}}</view>
          </view>
        </view>
      </block>
      <view class="form-item">
        <view class="form-label required">具体开始时间</view>
        <picker mode="time" value="{{form.start_time}}" bindchange="onStartTimeChange">
          <view class="picker-value">{{form.start_time || '请选择具体几点，例如 20:00'}}</view>
        </picker>
        <view class="field-help">粗时间段用于寻找共同空档，具体时间用于最终赴约。</view>
      </view>
      <view class="form-item">
        <view class="form-label required">活动场地</view>
        <input class="input field-input" maxlength="80" placeholder="例如：万象天地百老汇影城" value="{{form.activity_venue}}" data-key="activity_venue" bindinput="onInput" />
      </view>
      <view class="form-item">
        <view class="form-label">初步会合范围（选填）</view>
        <input class="input field-input" maxlength="80" placeholder="例如：影城大厅；不熟悉现场可以留空" value="{{form.meet_point}}" data-key="meet_point" bindinput="onInput" />
        <view class="field-help">这里只是提前约定的大致范围。到达后可再通知对方“吧台旁、靠窗座位”等现场位置。</view>
      </view>
      <view class="form-item">
        <view class="form-label">到场识别提示（选填）</view>
        <input class="input field-input" maxlength="60" placeholder="例如：深色上衣，手持一本书" value="{{form.arrival_hint}}" data-key="arrival_hint" bindinput="onInput" />
        <view class="field-help">双方确认方案后仍可补充。只写穿搭颜色或手持物，不要填写身份、单位、账号、数字或住址。</view>
      </view>
      <view class="form-item">
        <view class="form-label">🚌 出行限制</view>
        <input class="input field-input" placeholder="例如：不方便走远、需要靠近地铁" value="{{form.transport_constraints}}" data-key="transport_constraints" bindinput="onInput" />
        <view class="field-help">没有限制也可以留空，不需要填写详细地址</view>
      </view>
      <view class="form-item"><view class="form-label">📝 其他要求</view><textarea class="textarea" maxlength="100" placeholder="选填，告诉平台你在意的安排" value="{{form.other_requirements}}" data-key="other_requirements" bindinput="onInput"></textarea></view>
      <view class="public-note">建议选择白天、公共场所，尊重彼此的边界和节奏。</view>
      <button class="primary-btn full-btn" bindtap="submitApplication" loading="{{submitting}}" disabled="{{submitting}}">{{coordination.status === 'collecting_initiator' ? '发送第一次约会邀请' : '提交我的安排'}}</button>
    </view>

    <view class="optional-form-entry" wx:if="{{showOptionalFullForm && !showApplicationForm}}">
      <view class="response-option-copy">也可以提交一份完整候选方案，由系统比较双方差异并逐项协调。</view>
      <button class="outline-btn full-btn" bindtap="toggleOptionalForm">填写我的候选方案</button>
    </view>

    <view class="proposal-card card" wx:if="{{proposal && (coordination.status === 'waiting_confirmations' || coordination.status === 'arranged')}}">
      <view class="section-title">{{coordination.status === 'arranged' ? '方案确认完成' : '确认上方方案'}}</view>
      <view class="public-note" wx:if="{{coordination.status !== 'arranged'}}">方案来自系统计算结果，不是聊天文本。双方确认后才会生效。</view>
      <block wx:if="{{coordination.status === 'waiting_confirmations'}}">
        <button class="primary-btn full-btn" bindtap="confirmProposal" loading="{{submitting}}" disabled="{{submitting || coordination.confirmed_by_me}}">{{coordination.confirmed_by_me ? '你已确认，正在等待对方' : '确认这个方案'}}</button>
        <button class="outline-btn full-btn" bindtap="goCoordinator">和 AI 继续调整</button>
        <button class="outline-btn full-btn proposal-reject-btn" bindtap="rejectProposal" loading="{{submitting}}" disabled="{{submitting}}">这个方案不合适，继续协调</button>
      </block>
    </view>

    <view class="proposal-card counter-offer-card card" wx:if="{{coordination.status === 'no_overlap' && counterOfferCard}}">
      <view class="counter-offer-kicker">待回应的完整调整方案</view>
      <view class="section-title">{{counterOfferCard.title}}</view>
      <view class="public-note">{{counterOfferCard.body}}</view>
      <view class="counter-change-list">
        <view class="counter-change-row" wx:for="{{counterOfferCard.changes}}" wx:key="dimension">
          <text class="counter-change-label">{{item.label}}</text>
          <view class="counter-change-values">
            <text class="counter-change-before">{{item.before_text}}</text>
            <text class="counter-change-arrow">→</text>
            <text class="counter-change-after">{{item.after_text}}</text>
          </view>
        </view>
      </view>
      <view class="unchanged-note" wx:if="{{counterOfferCard.unchanged_text}}">保持不变：{{counterOfferCard.unchanged_text}}</view>
      <view class="counter-plan" wx:if="{{counterOfferCard.proposal_card}}">
        <view class="counter-plan-title">调整后的完整方案</view>
        <view class="fact-row"><text class="fact-label">时间</text><text class="fact-value">{{counterOfferCard.proposal_card.time_text}}</text></view>
        <view class="fact-row"><text class="fact-label">区域</text><text class="fact-value">{{counterOfferCard.proposal_card.area_text}}</text></view>
        <view class="fact-row"><text class="fact-label">活动</text><text class="fact-value">{{counterOfferCard.proposal_card.activity_text}}</text></view>
        <view class="fact-row"><text class="fact-label">预算</text><text class="fact-value">{{counterOfferCard.proposal_card.budget_text}}</text></view>
        <view class="fact-row"><text class="fact-label">费用方式</text><text class="fact-value">{{counterOfferCard.proposal_card.payment_text}}</text></view>
        <view class="fact-row"><text class="fact-label">时长</text><text class="fact-value">{{counterOfferCard.proposal_card.duration_text}}</text></view>
      </view>
      <button class="primary-btn full-btn" bindtap="acceptCounterOffer" loading="{{acceptingCounterOffer}}" disabled="{{acceptingCounterOffer}}">接受这份调整</button>
      <button class="outline-btn full-btn counter-offer-adjust" bindtap="goCoordinator">继续提出其他调整</button>
      <view class="muted counter-offer-hint">接受后只会对齐上面的改动项；系统生成最终方案后，双方仍需确认。</view>
    </view>

    <view class="proposal-card card" wx:if="{{coordination.status === 'no_overlap' && !counterOfferCard}}">
      <view class="section-title">还需要继续协调</view>
      <view class="public-note">已经一致的条件会保留在上方卡片里。请只和 AI 讨论还没解决的差异。</view>
      <button class="primary-btn full-btn" bindtap="goCoordinator">和 AI 继续协调</button>
    </view>

    <view class="support-card support-card-ai" wx:if="{{coordinationId && showCoordinatorCta}}" bindtap="goCoordinator" hover-class="support-card-pressed">
      <view class="support-icon">💗</view>
      <view class="support-content">
        <view class="support-title">AI约会协调员</view>
        <view class="support-desc">解释进度、理解自然语言、生成修改预览</view>
      </view>
      <view class="support-arrow">›</view>
    </view>
    <view class="support-card support-card-human" bindtap="goService" hover-class="support-card-pressed">
      <view class="support-icon">🎧</view>
      <view class="support-content">
        <view class="support-title">人工客服协助</view>
        <view class="support-desc">遇到复杂情况，由平台客服继续处理</view>
      </view>
      <view class="support-arrow">›</view>
    </view>
  </block>
</view>
