.date-page {
  padding-bottom: 64rpx;
}

.date-head {
  position: relative;
  background: #fff7f8;
  border: 2rpx solid #ffe1e8;
}

.test-data-badge {
  position: absolute;
  top: 16rpx;
  right: 20rpx;
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
  background: rgba(0, 0, 0, 0.04);
  color: #999;
  font-size: 20rpx;
  font-weight: 500;
}

.date-title {
  color: #333;
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.date-desc,
.invite-text,
.form-hint,
.muted,
.public-note {
  color: #777;
  font-size: 25rpx;
  line-height: 1.7;
}

.form-hint {
  margin: 0 0 20rpx;
}

.status-pill {
  display: inline-block;
  margin-top: 20rpx;
  padding: 8rpx 18rpx;
  border-radius: 24rpx;
  color: #ff6b8a;
  background: #fff;
  font-size: 23rpx;
}

.progress-row {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5e8eb;
  color: #666;
  font-size: 25rpx;
}

.progress-row:last-child {
  border-bottom: none;
}

.lifecycle-card {
  border: 2rpx solid #f3e4e8;
  background: #fff;
}

.lifecycle-main {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.lifecycle-round {
  color: #30292c;
  font-size: 32rpx;
  font-weight: 700;
}

.lifecycle-version,
.lifecycle-note {
  margin-top: 8rpx;
  color: #8c7b80;
  font-size: 23rpx;
  line-height: 1.6;
}

.lifecycle-state {
  flex: 0 0 auto;
  padding: 8rpx 16rpx;
  border-radius: 22rpx;
  color: #b64d69;
  background: #fff0f4;
  font-size: 23rpx;
}

.compact-btn {
  width: 100%;
  margin-top: 20rpx;
  min-height: var(--wf-touch-min);
}

.processing-card {
  border-left: 8rpx solid #ff7896;
}

.processing-card-failed {
  border-left-color: #c55b5b;
  background: #fffafa;
}

.proposal-reject-btn {
  margin-top: 18rpx;
}

.current-plan-card {
  border: 2rpx solid var(--wf-primary-soft, #f9dee4);
  background: var(--wf-card, #fff);
  box-shadow: var(--wf-shadow-card, 0 6rpx 24rpx rgba(214, 116, 140, 0.08));
}

.plan-card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.plan-kicker {
  margin-bottom: 8rpx;
  color: var(--wf-primary-strong, #d14d6b);
  font-size: 21rpx;
  letter-spacing: 1rpx;
}

.plan-ready-pill {
  flex: none;
  padding: 8rpx 16rpx;
  border-radius: 24rpx;
  font-size: 22rpx;
}

.plan-ready-pill.ready {
  color: var(--wf-success, #4caf87);
  background: rgba(76, 175, 135, 0.1);
}

.plan-ready-pill.pending {
  color: var(--wf-warning, #e8a23d);
  background: rgba(232, 162, 61, 0.1);
}

.plan-conflict {
  margin: 16rpx 0;
  padding: 18rpx 20rpx;
  border-left: 6rpx solid var(--wf-warning, #e8a23d);
  border-radius: var(--wf-radius-sm, 12rpx);
  background: rgba(232, 162, 61, 0.08);
  color: var(--wf-text-main, #3a2e2e);
  font-size: 25rpx;
  line-height: 1.6;
}

.plan-safe-note {
  margin: 18rpx 0;
  color: var(--wf-text-sub, #8c7b7b);
  font-size: 23rpx;
  line-height: 1.6;
}

.meeting-card {
  border-top: 8rpx solid var(--wf-success, #4caf87);
}

.arrival-status-row,
.meeting-code {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--wf-border, #f0e4e4);
  color: var(--wf-text-main, #3a2e2e);
  font-size: 26rpx;
}

.meeting-code-value {
  color: var(--wf-primary-strong, #d14d6b);
  font-weight: 700;
  letter-spacing: 4rpx;
}

.partner-hint {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border-radius: var(--wf-radius-md, 16rpx);
  background: var(--wf-primary-soft, #f9dee4);
  color: var(--wf-text-main, #3a2e2e);
  font-size: 25rpx;
  line-height: 1.6;
}

.meeting-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 18rpx;
}

.meeting-actions button {
  flex: 1;
  margin: 0;
}

.danger-text {
  color: var(--wf-danger, #d9534f) !important;
}

.response-option-copy {
  margin: 18rpx 4rpx 10rpx;
  color: var(--wf-text-sub, #8c7b7b);
  font-size: 24rpx;
  line-height: 1.6;
}

.counter-offer-card {
  border: 2rpx solid #ffb8c8;
  background: #fff8fa;
}

.counter-offer-kicker {
  margin-bottom: 10rpx;
  color: #b64d69;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.counter-change-list {
  margin-top: 22rpx;
  border-top: 1rpx solid var(--wf-border, #f0e4e4);
}

.counter-change-row {
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--wf-border, #f0e4e4);
}

.counter-change-label,
.counter-plan-title {
  color: var(--wf-text-sub, #8c7b7b);
  font-size: 24rpx;
  font-weight: 600;
}

.counter-change-values {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 8rpx;
  font-size: 27rpx;
  line-height: 1.5;
}

.counter-change-before {
  color: var(--wf-text-hint, #b5a5a5);
  text-decoration: line-through;
}

.counter-change-arrow {
  color: var(--wf-text-hint, #b5a5a5);
}

.counter-change-after {
  color: var(--wf-primary-strong, #d14d6b);
  font-weight: 600;
}

.unchanged-note {
  margin-top: 18rpx;
  padding: 16rpx 20rpx;
  border-radius: var(--wf-radius-md, 16rpx);
  background: var(--wf-primary-soft, #f9dee4);
  color: var(--wf-text-sub, #8c7b7b);
  font-size: 24rpx;
  line-height: 1.55;
}

.counter-plan {
  margin: 22rpx 0;
  padding: 22rpx;
  border: 1rpx solid var(--wf-border, #f0e4e4);
  border-radius: var(--wf-radius-md, 16rpx);
  background: var(--wf-card, #fff);
}

.counter-plan-title {
  margin-bottom: 10rpx;
}

.counter-offer-adjust {
  margin-top: 18rpx;
}

.counter-offer-hint {
  margin-top: 16rpx;
  line-height: 1.6;
}

.coordination-track {
  position: relative;
}

.coordination-step {
  display: flex;
  gap: 18rpx;
  position: relative;
  padding: 14rpx 0 22rpx;
  color: #746b70;
}

.coordination-step::after {
  content: '';
  position: absolute;
  left: 9rpx;
  top: 38rpx;
  bottom: -4rpx;
  width: 2rpx;
  background: #ede4e6;
}

.coordination-step:last-child::after {
  display: none;
}

.step-dot {
  flex: 0 0 20rpx;
  width: 20rpx;
  height: 20rpx;
  margin-top: 8rpx;
  border: 4rpx solid #ede4e6;
  border-radius: 50%;
  background: #fff9f7;
  box-sizing: border-box;
}

.coordination-step.active .step-dot {
  border-color: #ff6b8a;
  box-shadow: 0 0 0 8rpx rgba(255, 107, 138, 0.1);
}

.coordination-step.done .step-dot {
  border-color: #2f8a68;
  background: #2f8a68;
}

.step-title {
  color: #2b2729;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.45;
}

.step-desc {
  margin-top: 6rpx;
  color: #746b70;
  font-size: 24rpx;
  line-height: 1.65;
}

.choice-list,
.action-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 16rpx;
}

.choice-tag {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: var(--wf-touch-min);
  padding: 8rpx 20rpx;
  border: 2rpx solid #f1ecee;
  border-radius: 30rpx;
  background: #f8f8f8;
  color: #666;
  font-size: 24rpx;
  line-height: 1.25;
  box-sizing: border-box;
}

.choice-tag.selected {
  border-color: #ff6688;
  background: #ff6688;
  color: #fff;
  font-weight: 600;
  box-shadow: 0 6rpx 14rpx rgba(255, 102, 136, 0.2);
}

.choice-tag-pressed {
  opacity: 0.78;
  transform: scale(0.97);
}

.date-choice {
  margin-top: 18rpx;
  padding: 20rpx;
  border-radius: 18rpx;
  background: #fff7f8;
}

.date-choice-head {
  display: flex;
  justify-content: space-between;
  color: #444;
  font-size: 26rpx;
  font-weight: 600;
}

.remove-date {
  min-height: var(--wf-touch-min);
  padding: 16rpx 20rpx;
  margin: -16rpx -20rpx -16rpx 0;
  color: #ff6b8a;
  font-weight: 400;
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.selected-periods {
  margin-top: 12rpx;
  color: #999;
  font-size: 22rpx;
}

.input,
.textarea {
  width: 100%;
  background: #fafafa;
  border-radius: 14rpx;
  padding: 20rpx;
  box-sizing: border-box;
  color: #333;
  font-size: 26rpx;
}

.field-input {
  height: 88rpx;
  min-height: 88rpx;
  border: 2rpx solid #f5dce3;
  background: #fffafb;
  line-height: 44rpx;
}

.field-input:focus {
  border-color: #ff8ca4;
  background: #fff;
}

.field-help {
  margin-top: 10rpx;
  color: #a58f95;
  font-size: 22rpx;
  line-height: 1.5;
}

.textarea {
  min-height: 130rpx;
}

.share-preview {
  padding: 22rpx;
  border-radius: 16rpx;
  background: #fff4f6;
  color: #75404c;
  font-size: 25rpx;
  line-height: 1.6;
  margin-bottom: 20rpx;
}

.preview-label {
  font-weight: 600;
  margin-bottom: 8rpx;
}

.public-note {
  padding: 16rpx 0 22rpx;
}

.primary-btn,
.outline-btn {
  flex: 1;
  min-width: 200rpx;
  min-height: var(--wf-touch-min);
  height: auto;
  line-height: 1.3;
  margin: 0;
  padding: 18rpx 20rpx;
  border-radius: 39rpx;
  font-size: 27rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.primary-btn {
  background: #ff6b8a;
  color: #fff;
}

.outline-btn {
  background: #fff;
  color: #ff6b8a;
  border: 2rpx solid #ff6b8a;
}

.primary-btn::after,
.outline-btn::after {
  border: none;
}

.full-btn {
  width: 100%;
}

.coordinator-hero {
  margin-bottom: 24rpx;
  border: 2rpx solid #ffd0dc;
}

.coordinator-hint {
  margin: 16rpx 0 12rpx;
  line-height: 1.7;
}

.proposal-line {
  color: #555;
  font-size: 26rpx;
  line-height: 1.8;
}

.support-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 132rpx;
  margin: 24rpx 0 0;
  padding: 24rpx 26rpx;
  border: 2rpx solid #ffdce5;
  border-radius: 20rpx;
  box-sizing: border-box;
  box-shadow: 0 8rpx 22rpx rgba(92, 51, 62, 0.07);
}

.support-card-ai {
  background: #fff2f6;
}

.support-card-human {
  background: #fff;
}

.support-card-pressed {
  opacity: 0.82;
  transform: scale(0.99);
}

.support-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 74rpx;
  width: 74rpx;
  height: 74rpx;
  border-radius: 50%;
  background: #fff;
  font-size: 36rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 102, 136, 0.12);
}

.support-content {
  flex: 1;
  min-width: 0;
}

.support-title {
  color: #4b3c40;
  font-size: 29rpx;
  font-weight: 600;
  line-height: 1.35;
}

.support-desc {
  margin-top: 7rpx;
  color: #8b7c80;
  font-size: 23rpx;
  line-height: 1.5;
}

.support-arrow {
  flex: 0 0 auto;
  color: #ff6688;
  font-size: 46rpx;
  line-height: 1;
}

.fact-card,
.invite-actions,
.result-card {
  background: #fff;
}

.fact-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f5e8eb;
}

.fact-row:last-child {
  border-bottom: none;
}

.fact-mark {
  width: 16rpx;
  height: 16rpx;
  flex: 0 0 16rpx;
  margin-top: 12rpx;
  border-radius: 50%;
  background: var(--wf-color-warning);
}

.fact-mark.ok {
  background: var(--wf-color-success);
}

.fact-mark.warn {
  background: var(--wf-color-warning);
}

.fact-label {
  min-width: 120rpx;
  flex: 0 0 auto;
  color: #888;
  font-size: 25rpx;
}

.fact-value {
  flex: 1;
  color: #333;
  font-size: 27rpx;
  line-height: 1.5;
}

.text-btn {
  margin-top: 12rpx;
  min-height: var(--wf-touch-min);
  background: transparent;
  color: #8b7c80;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.optional-form-entry {
  margin: 8rpx 0 24rpx;
}

.venue-clarification-card {
  margin-top: 16rpx;
  padding: 20rpx 22rpx;
  border: 1rpx solid rgba(163, 126, 204, 0.28);
  border-radius: 20rpx;
  background: linear-gradient(135deg, #fbf8ff 0%, #fff9fc 100%);
}

.venue-clarification-title {
  color: #76548f;
  font-size: 26rpx;
  font-weight: 600;
}

.venue-clarification-row,
.venue-clarification-missing {
  margin-top: 8rpx;
  color: var(--wf-text-sub, #8C7B7B);
  font-size: 24rpx;
  line-height: 1.55;
}

.venue-clarification-missing {
  color: #a45f7d;
}

.qa-reset-card {
  margin: -4rpx 0 24rpx;
  padding: 22rpx 26rpx;
  border: 1rpx dashed var(--wf-warning, #E8A23D);
  border-radius: var(--wf-radius-lg, 24rpx);
  background: rgba(255, 250, 238, 0.82);
}

.qa-reset-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.qa-reset-copy { flex: 1; min-width: 0; }

.qa-reset-kicker {
  color: var(--wf-warning, #E8A23D);
  font-size: var(--wf-fs-tiny, 20rpx);
  font-weight: 600;
  letter-spacing: 2rpx;
}

.qa-reset-title {
  margin-top: 8rpx;
  color: var(--wf-text-main, #3A2E2E);
  font-size: var(--wf-fs-body, 28rpx);
  font-weight: 600;
}

.qa-reset-desc {
  margin-top: 8rpx;
  color: var(--wf-text-sub, #8C7B7B);
  font-size: var(--wf-fs-caption, 24rpx);
  line-height: 1.6;
}

.qa-reset-btn {
  flex: 0 0 184rpx;
  min-height: var(--wf-touch-min);
  height: auto;
  margin: 0;
  padding: 0 20rpx;
  border: 1rpx solid var(--wf-warning, #E8A23D);
  border-radius: 44rpx;
  background: #FFFFFF;
  color: #9A6A1E;
  font-size: 26rpx;
  line-height: 1.3;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.qa-reset-btn::after { border: 0; }

.qa-advance-btn {
  width: 100%;
  margin-top: 16rpx;
  flex: none;
}
