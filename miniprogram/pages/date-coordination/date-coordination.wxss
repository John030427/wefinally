.date-page {
  padding-bottom: 64rpx;
}

.date-head {
  background: #fff7f8;
  border: 2rpx solid #ffe1e8;
}

.date-title {
  color: #333;
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.date-desc,
.invite-text,
.muted,
.public-note {
  color: #777;
  font-size: 25rpx;
  line-height: 1.7;
}

.status-pill {
  display: inline-block;
  margin-top: 20rpx;
  padding: 8rpx 18rpx;
  border-radius: 24rpx;
  color: #ff6b8a;
  background: #fff;
  font-size: 23rpx;
}

.progress-row,
.contact-card {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5e8eb;
  color: #666;
  font-size: 25rpx;
}

.progress-row:last-child,
.contact-card {
  border-bottom: none;
}

.choice-list,
.action-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 16rpx;
}

.choice-tag {
  padding: 12rpx 18rpx;
  border-radius: 24rpx;
  background: #f7f7f7;
  color: #666;
  font-size: 24rpx;
}

.choice-tag.selected {
  background: #ff6b8a;
  color: #fff;
}

.date-choice {
  margin-top: 18rpx;
  padding: 20rpx;
  border-radius: 18rpx;
  background: #fff7f8;
}

.date-choice-head {
  display: flex;
  justify-content: space-between;
  color: #444;
  font-size: 26rpx;
  font-weight: 600;
}

.remove-date {
  color: #ff6b8a;
  font-weight: 400;
}

.selected-periods {
  margin-top: 12rpx;
  color: #999;
  font-size: 22rpx;
}

.input,
.textarea {
  width: 100%;
  background: #fafafa;
  border-radius: 14rpx;
  padding: 20rpx;
  box-sizing: border-box;
  color: #333;
  font-size: 26rpx;
}

.textarea {
  min-height: 130rpx;
}

.share-preview {
  padding: 22rpx;
  border-radius: 16rpx;
  background: #fff4f6;
  color: #75404c;
  font-size: 25rpx;
  line-height: 1.6;
  margin-bottom: 20rpx;
}

.preview-label {
  font-weight: 600;
  margin-bottom: 8rpx;
}

.public-note {
  padding: 16rpx 0 22rpx;
}

.primary-btn,
.outline-btn {
  flex: 1;
  min-width: 200rpx;
  height: 78rpx;
  line-height: 78rpx;
  margin: 0;
  padding: 0 20rpx;
  border-radius: 39rpx;
  font-size: 27rpx;
}

.primary-btn {
  background: #ff6b8a;
  color: #fff;
}

.outline-btn {
  background: #fff;
  color: #ff6b8a;
  border: 2rpx solid #ff6b8a;
}

.primary-btn::after,
.outline-btn::after {
  border: none;
}

.full-btn {
  width: 100%;
}

.proposal-line {
  color: #555;
  font-size: 26rpx;
  line-height: 1.8;
}

.contact-card {
  align-items: center;
}

.contact-link {
  color: #ff6b8a;
  flex: 0 0 auto;
}
