/* 第一次约会 / AI 协调 — 统一状态叙事：邀请 → 协调 → 确认 → 安排 */
.date-page {
  padding-bottom: calc(64rpx + env(safe-area-inset-bottom));
}

/* ===== 顶部状态卡 ===== */

.date-head {
  position: relative;
  background: linear-gradient(160deg, #FFFFFF 0%, #FDF6F4 100%);
  overflow: hidden;
}

.test-data-badge {
  position: absolute;
  top: 20rpx;
  right: 24rpx;
  padding: 4rpx 16rpx;
  border-radius: var(--wf-radius-pill);
  background: var(--wf-warning-soft);
  color: var(--wf-warning);
  font-size: var(--wf-fs-tiny);
  font-weight: 500;
}

.date-kicker {
  font-size: var(--wf-fs-tiny);
  letter-spacing: 2rpx;
  color: var(--wf-text-hint);
  margin-bottom: 10rpx;
}

.date-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.date-title {
  color: var(--wf-text-main);
  font-size: var(--wf-fs-h1);
  font-weight: 700;
}

.date-desc,
.muted,
.public-note {
  margin-top: 14rpx;
  font-size: var(--wf-fs-caption);
  color: var(--wf-text-sub);
  line-height: 1.7;
}

.muted {
  color: var(--wf-text-hint);
}

.public-note {
  margin-top: 10rpx;
}

/* 步骤条 */
.date-steps {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
  padding: 18rpx 24rpx;
  background: rgba(255, 255, 255, 0.75);
  border: 1rpx solid var(--wf-border);
  border-radius: var(--wf-radius-md);
}

.date-step {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  font-size: var(--wf-fs-tiny);
  color: var(--wf-text-hint);
}

.date-step-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #E8DCDA;
  transition: all 0.3s;
}

.date-step.done {
  color: var(--wf-primary-strong);
  font-weight: 600;
}

.date-step.done .date-step-dot {
  background: var(--wf-primary);
  box-shadow: 0 0 0 6rpx var(--wf-primary-soft);
}

.date-step-line {
  flex: 1;
  height: 3rpx;
  margin: 0 10rpx 22rpx;
  background: #EFE3E0;
  border-radius: 2rpx;
}

.date-step-line.done {
  background: var(--wf-primary);
}

/* ===== 结果 / 邀请卡 ===== */

.invite-text {
  font-size: var(--wf-fs-body);
  color: var(--wf-text-main);
  line-height: 1.8;
  background: var(--wf-primary-soft-2);
  border-radius: var(--wf-radius-sm);
  padding: 20rpx 24rpx;
}

.invite-actions {
  padding: 28rpx 32rpx;
}

/* ===== 协调进度步骤（fixture 模拟） ===== */

.coordination-track .coordination-step {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 18rpx 0;
}

.step-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #E8DCDA;
  margin-top: 8rpx;
  flex-shrink: 0;
}

.coordination-step.done .step-dot {
  background: var(--wf-success);
}

.coordination-step.active .step-dot {
  background: var(--wf-primary);
  box-shadow: 0 0 0 8rpx var(--wf-primary-soft);
  animation: wf-date-pulse 1.8s ease-in-out infinite;
}

.step-copy {
  flex: 1;
}

.step-title {
  font-size: var(--wf-fs-body);
  font-weight: 600;
  color: var(--wf-text-main);
}

.step-desc {
  margin-top: 4rpx;
  font-size: var(--wf-fs-tiny);
  color: var(--wf-text-sub);
  line-height: 1.6;
}

/* ===== 事实卡（时间/区域/活动…） ===== */

.fact-card {
  padding: 28rpx 32rpx;
}

.fact-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--wf-border);
}

.fact-row:last-child {
  border-bottom: none;
}

.fact-mark {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  flex-shrink: 0;
}

.fact-mark.ok {
  background: var(--wf-success-soft);
  color: var(--wf-success);
}

.fact-mark.warn {
  background: var(--wf-warning-soft);
  color: var(--wf-warning);
}

.fact-label {
  width: 150rpx;
  font-size: var(--wf-fs-caption);
  color: var(--wf-text-sub);
  flex-shrink: 0;
}

.fact-value {
  flex: 1;
  font-size: var(--wf-fs-caption);
  font-weight: 500;
  color: var(--wf-text-main);
  text-align: right;
}

/* ===== 处理中 / 失败 / 转人工 ===== */

.processing-card {
  padding: 20rpx 24rpx;
}

.processing-card-failed {
  border: 2rpx solid var(--wf-danger-soft);
  background: #FFFafa;
}

.coordinator-hero {
  padding: 28rpx 32rpx;
}

.ai-dislosure-line {
  margin-top: 4rpx;
}

.coordinator-hint {
  margin: 14rpx 0 4rpx;
}

/* ===== 按钮（页面局部体系） ===== */

.primary-btn {
  background: var(--wf-primary-grad);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: var(--wf-radius-pill);
  border: none;
  box-shadow: var(--wf-shadow-cta);
}

.primary-btn::after {
  border: none;
}

.outline-btn {
  background: var(--wf-card);
  color: var(--wf-primary-strong);
  font-size: var(--wf-fs-caption);
  font-weight: 500;
  border-radius: var(--wf-radius-pill);
  border: 2rpx solid var(--wf-primary-soft);
}

.outline-btn::after {
  border: none;
}

.text-btn {
  background: transparent;
  color: var(--wf-text-sub);
  font-size: var(--wf-fs-caption);
  border: none;
}

.text-btn::after {
  border: none;
}

.full-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  margin-top: 20rpx;
}

.compact-btn {
  width: 100%;
  height: 76rpx;
  line-height: 76rpx;
  margin-top: 14rpx;
}

.proposal-reject-btn {
  color: var(--wf-text-sub);
  border-color: var(--wf-border);
}

/* ===== 表单 ===== */

.form-card {
  padding: 32rpx;
}

.form-hint {
  font-size: var(--wf-fs-caption);
  color: var(--wf-text-sub);
  line-height: 1.7;
  margin-bottom: 20rpx;
}

.form-label {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: var(--wf-fs-body);
  font-weight: 500;
  color: var(--wf-text-main);
  margin: 20rpx 0 12rpx;
}

.form-label.required::after {
  content: ' *';
  color: var(--wf-primary);
}

.form-label-icon {
  color: var(--wf-primary);
}

.field-input,
.input {
  width: 100%;
  background: var(--wf-primary-soft-2);
  border-radius: var(--wf-radius-sm);
  padding: 22rpx 26rpx;
  font-size: var(--wf-fs-body);
  box-sizing: border-box;
  color: var(--wf-text-main);
}

.field-help {
  margin-top: 8rpx;
  font-size: var(--wf-fs-tiny);
  color: var(--wf-text-hint);
}

.textarea {
  width: 100%;
  min-height: 140rpx;
  background: var(--wf-primary-soft-2);
  border-radius: var(--wf-radius-sm);
  padding: 22rpx 26rpx;
  font-size: var(--wf-fs-body);
  box-sizing: border-box;
}

.date-choice {
  margin-top: 18rpx;
  background: #FCF8F7;
  border-radius: var(--wf-radius-sm);
  padding: 20rpx 24rpx;
}

.date-choice-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: var(--wf-fs-caption);
  font-weight: 600;
  color: var(--wf-text-main);
}

.remove-date {
  font-size: var(--wf-fs-tiny);
  color: var(--wf-text-hint);
  font-weight: 400;
}

.choice-list {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.choice-tag {
  padding: 12rpx 28rpx;
  border-radius: var(--wf-radius-pill);
  border: 2rpx solid var(--wf-border);
  background: var(--wf-card);
  font-size: var(--wf-fs-caption);
  color: var(--wf-text-sub);
  transition: all 0.15s;
}

.choice-tag.selected {
  border-color: var(--wf-primary);
  background: var(--wf-primary-soft-2);
  color: var(--wf-primary-strong);
  font-weight: 600;
}

.choice-tag-pressed {
  opacity: 0.75;
}

.selected-periods {
  margin-top: 12rpx;
  font-size: var(--wf-fs-tiny);
  color: var(--wf-text-sub);
}

.optional-form-entry {
  margin-top: 4rpx;
}

/* ===== 支持入口 ===== */

.support-card {
  display: flex;
  align-items: center;
  gap: 22rpx;
  background: var(--wf-card);
  border-radius: var(--wf-radius-lg);
  border: 1rpx solid rgba(240, 228, 228, 0.6);
  box-shadow: var(--wf-shadow-card);
  padding: 26rpx 30rpx;
  margin-bottom: 20rpx;
}

.support-card-ai .support-icon {
  background: var(--wf-ai-soft);
}

.support-card-ai .support-icon .wf-icon {
  color: var(--wf-ai);
}

.support-icon {
  width: 84rpx;
  height: 84rpx;
  border-radius: var(--wf-radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: var(--wf-primary-soft-2);
}

.support-icon.human .wf-icon {
  color: var(--wf-primary);
}

.support-content {
  flex: 1;
  min-width: 0;
}

.support-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--wf-text-main);
}

.support-desc {
  margin-top: 4rpx;
  font-size: var(--wf-fs-tiny);
  color: var(--wf-text-sub);
}

.support-card-pressed {
  opacity: 0.85;
  transform: scale(0.99);
}

@keyframes wf-date-pulse {
  0%, 100% { box-shadow: 0 0 0 6rpx var(--wf-primary-soft); }
  50% { box-shadow: 0 0 0 12rpx rgba(249, 222, 228, 0.5); }
}
